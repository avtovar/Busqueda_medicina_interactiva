      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen bg-slate-50 font-[Inter,ui-sans-serif,system-ui,sans-serif] text-slate-900\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"border-b border-emerald-100 bg-emerald-50 px-4 py-2 text-center text-xs font-bold uppercase tracking-wide text-emerald-900\" data-kid=\"1-1\" data-name=\"status banner text\">\n        IN USE · Vista desktop implementada\n    </div>\n    <header class=\"border-b border-slate-200 bg-white\" data-kid=\"1-2\" data-name=\"header section\">\n        <div class=\"mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6 lg:px-8\" data-kid=\"1-2-1\" data-name=\"header content container\">\n            <a aria-label=\"FarmaciaCerca, inicio\" class=\"flex items-center gap-3\" data-kid=\"1-2-1-1\" data-name=\"home link\" href=\"#\">\n                <span class=\"flex size-10 items-center justify-center rounded-xl bg-sky-600 text-white shadow-sm shadow-sky-900/15\" data-kid=\"1-2-1-1-1\" data-name=\"logo container\">\n                    <span class=\"text-[30px] font-light leading-none\" data-kid=\"1-2-1-1-1-1\" data-name=\"plus icon\">\n                        +\n                    </span>\n                </span>\n                <span data-kid=\"1-2-1-1-2\" data-name=\"app title container\">\n                    <span class=\"block text-sm font-extrabold tracking-tight text-slate-950\" data-kid=\"1-2-1-1-2-1\" data-name=\"app brand name\">\n                        FarmaciaCerca\n                    </span>\n                    <span class=\"mt-0.5 block text-xs font-medium text-slate-600\" data-kid=\"1-2-1-1-2-2\" data-name=\"data source notice\">\n                        Precio de referencia · Ministerio de Salud\n                    </span>\n                </span>\n            </a>\n            <div class=\"flex items-center gap-2 sm:gap-3\" data-kid=\"1-2-1-2\" data-name=\"header utility buttons container\">\n                <button aria-label=\"Cambiar tema\" class=\"flex size-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600\" data-kid=\"1-2-1-2-1\" data-name=\"theme toggle button\">\n                    <i class=\"ti ti-moon text-lg\" data-kid=\"1-2-1-2-1-1\" data-name=\"moon icon\">\n                    </i>\n                </button>\n                <button class=\"inline-flex min-h-11 items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 text-xs font-bold text-slate-700 sm:px-4 sm:text-sm\" data-kid=\"1-2-1-2-2\" data-name=\"location button\">\n                    <i class=\"ti ti-map-pin text-base\" data-kid=\"1-2-1-2-2-1\" data-name=\"map pin icon\">\n                    </i>\n                    <span class=\"hidden sm:inline\" data-kid=\"1-2-1-2-2-2\" data-name=\"location button text\">\n                        Usar mi ubicación\n                    </span>\n                    <span class=\"sm:hidden\" data-kid=\"1-2-1-2-2-3\" data-name=\"location button mobile text\">\n                        Ubicación\n                    </span>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-6xl px-4 pb-12 pt-8 sm:px-6 sm:pt-10 lg:px-8\" data-kid=\"1-3\" data-name=\"main content area\">\n        <section aria-labelledby=\"search-title\" data-kid=\"1-3-1\" data-name=\"search section\">\n            <div class=\"max-w-4xl\" data-kid=\"1-3-1-1\" data-name=\"search title container\">\n                <h1 class=\"text-3xl font-extrabold leading-tight tracking-tight text-slate-950 sm:text-4xl\" data-kid=\"1-3-1-1-1\" data-name=\"search headline\" id=\"search-title\">\n                    Buscá por principio activo o nombre comercial\n                </h1>\n                <p class=\"mt-2 text-base leading-6 text-slate-600\" data-kid=\"1-3-1-1-2\" data-name=\"search subtitle\">\n                    Compará precios de referencia entre laboratorios para una misma presentación.\n                </p>\n            </div>\n            <div class=\"mt-6 flex items-center gap-2 rounded-2xl border border-slate-200 bg-white p-1.5 shadow-sm shadow-slate-900/5\" data-kid=\"1-3-1-2\" data-name=\"search input wrapper\">\n                <i class=\"ti ti-search ml-3 text-xl text-slate-400\" data-kid=\"1-3-1-2-1\" data-name=\"search icon\">\n                </i>\n                <label class=\"sr-only\" data-kid=\"1-3-1-2-2\" data-name=\"search label\" for=\"medicine-search\">\n                    Buscar por principio activo o nombre comercial\n                </label>\n                <input class=\"h-12 min-w-0 flex-1 bg-transparent px-1 text-base text-slate-900 outline-none placeholder:text-slate-400\" data-kid=\"1-3-1-2-3\" data-name=\"medicine search input field\" id=\"medicine-search\" placeholder=\"Ej. ibuprofeno, paracetamol, Actron\" type=\"search\" value=\"ibuprofeno\"/>\n                <button aria-label=\"Limpiar búsqueda\" class=\"inline-flex min-h-11 items-center gap-2 rounded-xl px-3 text-sm font-semibold text-slate-600\" data-kid=\"1-3-1-2-4\" data-name=\"clear search button\">\n                    <i class=\"ti ti-x text-base\" data-kid=\"1-3-1-2-4-1\" data-name=\"clear search icon\">\n                    </i>\n                    <span class=\"hidden sm:inline\" data-kid=\"1-3-1-2-4-2\" data-name=\"clear search text\">\n                        Limpiar\n                    </span>\n                </button>\n            </div>\n            <p class=\"mt-2.5 text-sm leading-5 text-slate-500\" data-kid=\"1-3-1-3\" data-name=\"search note\">\n                El precio se compara entre laboratorios de una misma presentación.\n            </p>\n            <p class=\"mt-2 border-b border-slate-200 pb-5 text-sm text-slate-600\" data-kid=\"1-3-1-4\" data-name=\"catalog stats\">\n                <strong class=\"font-semibold text-slate-800\" data-kid=\"1-3-1-4-1\" data-name=\"catalog stats bold text\">\n                    Catálogo parcial\n                </strong>\n                · 1.923 productos\n            </p>\n        </section>\n        <section aria-labelledby=\"prices-title\" class=\"mt-8\" data-kid=\"1-3-2\" data-name=\"results section\">\n            <div class=\"mb-4 flex flex-col gap-3 border-b border-slate-200 pb-4 sm:flex-row sm:items-end sm:justify-between\" data-kid=\"1-3-2-1\" data-name=\"results header container\">\n                <div data-kid=\"1-3-2-1-1\" data-name=\"results title container\">\n                    <h2 class=\"text-2xl font-bold tracking-tight text-slate-950\" data-kid=\"1-3-2-1-1-1\" data-name=\"results headline\" id=\"prices-title\">\n                        Precios de referencia\n                    </h2>\n                    <p class=\"mt-1 text-sm text-slate-600\" data-kid=\"1-3-2-1-1-2\" data-name=\"results summary text\">\n                        13 composiciones para “ibuprofeno”\n                        <span class=\"mx-1.5 text-slate-400\" data-kid=\"1-3-2-1-1-2-1\" data-name=\"separator dot 1\">\n                            ·\n                        </span>\n                        <strong class=\"font-semibold text-slate-800\" data-kid=\"1-3-2-1-1-2-2\" data-name=\"main result count\">\n                            1 coincidencia principal\n                        </strong>\n                        <span class=\"mx-1.5 text-slate-400\" data-kid=\"1-3-2-1-1-2-3\" data-name=\"separator dot 2\">\n                            ·\n                        </span>\n                        12 relacionadas\n                    </p>\n                </div>\n                <div class=\"w-full sm:w-64\" data-kid=\"1-3-2-1-2\" data-name=\"sorting control container\">\n                    <label class=\"mb-1.5 block text-sm font-semibold text-slate-600\" data-kid=\"1-3-2-1-2-1\" data-name=\"sort label\" for=\"sort-results\">\n                        Ordenar resultados\n                    </label>\n                    <select class=\"h-11 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm font-medium text-slate-700\" data-kid=\"1-3-2-1-2-2\" data-name=\"sort results dropdown\" id=\"sort-results\">\n                        <option data-kid=\"1-3-2-1-2-2-1\" data-name=\"sort option 1\">\n                            Menor precio mínimo de referencia\n                        </option>\n                        <option data-kid=\"1-3-2-1-2-2-2\" data-name=\"sort option 2\">\n                            Mayor precio mínimo de referencia\n                        </option>\n                        <option data-kid=\"1-3-2-1-2-2-3\" data-name=\"sort option 3\">\n                            Más productos\n                        </option>\n                        <option data-kid=\"1-3-2-1-2-2-4\" data-name=\"sort option 4\">\n                            Nombre (A–Z)\n                        </option>\n                    </select>\n                    <p class=\"mt-1.5 text-xs leading-5 text-slate-500\" data-kid=\"1-3-2-1-2-3\" data-name=\"sorting explanation text\">\n                        Ordena por el mínimo de cada composición; puede corresponder a distintas presentaciones.\n                    </p>\n                </div>\n            </div>\n            <div class=\"grid items-start gap-x-9 gap-y-7 lg:grid-cols-[minmax(0,1.55fr)_minmax(18rem,0.85fr)]\" data-kid=\"1-3-2-2\" data-name=\"main results layout\">\n                <section aria-labelledby=\"principal-title\" class=\"min-w-0\" data-kid=\"1-3-2-2-1\" data-name=\"principal matches section\">\n                    <div class=\"mb-3 flex items-center justify-between gap-4\" data-kid=\"1-3-2-2-1-1\" data-name=\"principal matches header\">\n                        <h3 class=\"text-base font-bold text-slate-800\" data-kid=\"1-3-2-2-1-1-1\" data-name=\"principal matches title\" id=\"principal-title\">\n                            Coincidencias principales\n                        </h3>\n                        <span class=\"text-sm text-slate-500\" data-kid=\"1-3-2-2-1-1-2\" data-name=\"principal matches count\">\n                            1 composición\n                        </span>\n                    </div>\n                    <ul class=\"space-y-4\" data-kid=\"1-3-2-2-1-2\" data-name=\"principal matches list\">\n                        <li data-kid=\"1-3-2-2-1-2-1\" data-name=\"principal match item\">\n                            <article class=\"rounded-2xl border border-slate-200 bg-white p-4 shadow-sm shadow-slate-900/5 sm:p-5\" data-kid=\"1-3-2-2-1-2-1-1\" data-name=\"principal match card\">\n                                <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-3-2-2-1-2-1-1-1\" data-name=\"principal match card row\">\n                                    <div class=\"min-w-0\" data-kid=\"1-3-2-2-1-2-1-1-1-1\" data-name=\"principal match info\">\n                                        <span class=\"text-xs font-semibold text-sky-800\" data-kid=\"1-3-2-2-1-2-1-1-1-1-1\" data-name=\"match category label\">\n                                            Principio activo\n                                        </span>\n                                        <h4 class=\"mt-1.5 break-words text-lg font-bold tracking-tight text-slate-950\" data-kid=\"1-3-2-2-1-2-1-1-1-1-2\" data-name=\"match title\">\n                                            ibuprofeno\n                                        </h4>\n                                        <p class=\"mt-1 text-sm leading-5 text-slate-600\" data-kid=\"1-3-2-2-1-2-1-1-1-1-3\" data-name=\"match products count\">\n                                            159 productos en 78 presentaciones · incluye IBUPROFENO FECOFAR, IBUPROFENO ROSPAW 400\n                                        </p>\n                                    </div>\n                                    <div class=\"shrink-0 text-right\" data-kid=\"1-3-2-2-1-2-1-1-1-2\" data-name=\"price info\">\n                                        <p class=\"text-xs font-medium text-slate-600\" data-kid=\"1-3-2-2-1-2-1-1-1-2-1\" data-name=\"price label\">\n                                            Desde · referencia\n                                        </p>\n                                        <p class=\"mt-0.5 text-xl font-extrabold tracking-tight text-sky-800\" data-kid=\"1-3-2-2-1-2-1-1-1-2-2\" data-name=\"price value\">\n                                            $ 663\n                                        </p>\n                                        <p class=\"mt-1 max-w-40 text-xs leading-4 text-slate-500\" data-kid=\"1-3-2-2-1-2-1-1-1-2-3\" data-name=\"price sublabel\">\n                                            Mínimo entre distintas presentaciones\n                                        </p>\n                                    </div>\n                                </div>\n                                <ul class=\"mt-3 divide-y divide-slate-200\" data-kid=\"1-3-2-2-1-2-1-1-2\" data-name=\"presentations list\">\n                                    <li class=\"py-4 first:pt-4\" data-kid=\"1-3-2-2-1-2-1-1-2-1\" data-name=\"presentation item\">\n                                        <div class=\"flex flex-wrap items-start justify-between gap-x-4 gap-y-2\" data-kid=\"1-3-2-2-1-2-1-1-2-1-1\" data-name=\"presentation item container\">\n                                            <div class=\"min-w-0\" data-kid=\"1-3-2-2-1-2-1-1-2-1-1-1\" data-name=\"presentation details\">\n                                                <p class=\"text-sm font-bold text-slate-900\" data-kid=\"1-3-2-2-1-2-1-1-2-1-1-1-1\" data-name=\"presentation name\">\n                                                    susp.oral x 90 ml\n                                                </p>\n                                                <p class=\"mt-0.5 text-sm text-slate-600\" data-kid=\"1-3-2-2-1-2-1-1-2-1-1-1-2\" data-name=\"presentation type\">\n                                                    jarabe · vía oral\n                                                </p>\n                                            </div>\n                                            <div class=\"text-right\" data-kid=\"1-3-2-2-1-2-1-1-2-1-1-2\" data-name=\"presentation price range\">\n                                                <p class=\"text-lg font-extrabold tracking-tight text-slate-900\" data-kid=\"1-3-2-2-1-2-1-1-2-1-1-2-1\" data-name=\"presentation price\">\n                                                    $ 663 - $ 12.608\n                                                </p>\n                                                <p class=\"text-sm text-slate-600\" data-kid=\"1-3-2-2-1-2-1-1-2-1-1-2-2\" data-name=\"presentation range label\">\n                                                    hasta 19,0 x de diferencia\n                                                </p>\n                                            </div>\n                                        </div>\n                                        <p class=\"mt-2 text-sm text-slate-600\" data-kid=\"1-3-2-2-1-2-1-1-2-1-2\" data-name=\"lowest price info\">\n                                            <strong class=\"font-semibold text-slate-800\" data-kid=\"1-3-2-2-1-2-1-1-2-1-2-1\" data-name=\"lowest price bold text\">\n                                                Más barato:\n                                            </strong>\n                                            IBUPROFENO FECOFAR · Fecofar · $ 663\n                                        </p>\n                                        <button class=\"mt-2 inline-flex min-h-11 items-center gap-1.5 rounded-lg px-2 text-sm font-semibold text-sky-800\" data-kid=\"1-3-2-2-1-2-1-1-2-1-3\" data-name=\"toggle presentation button\">\n                                            <i class=\"ti ti-chevron-down\" data-kid=\"1-3-2-2-1-2-1-1-2-1-3-1\" data-name=\"chevron icon\">\n                                            </i>\n                                            Ver 5 productos\n                                        </button>\n                                    </li>\n                                    <li class=\"py-4\" data-kid=\"1-3-2-2-1-2-1-1-2-2\" data-name=\"presentation item 2\">\n                                        <div class=\"flex flex-wrap items-start justify-between gap-x-4 gap-y-2\" data-kid=\"1-3-2-2-1-2-1-1-2-2-1\" data-name=\"presentation item container 2\">\n                                            <div class=\"min-w-0\" data-kid=\"1-3-2-2-1-2-1-1-2-2-1-1\" data-name=\"presentation details 2\">\n                                                <p class=\"text-sm font-bold text-slate-900\" data-kid=\"1-3-2-2-1-2-1-1-2-2-1-1-1\" data-name=\"presentation name 2\">\n                                                    400 mg comp.x 10\n                                                </p>\n                                                <p class=\"mt-0.5 text-sm text-slate-600\" data-kid=\"1-3-2-2-1-2-1-1-2-2-1-1-2\" data-name=\"presentation type 2\">\n                                                    comprimido · vía oral\n                                                </p>\n                                            </div>\n                                            <div class=\"text-right\" data-kid=\"1-3-2-2-1-2-1-1-2-2-1-2\" data-name=\"presentation price range 2\">\n                                                <p class=\"text-lg font-extrabold tracking-tight text-slate-900\" data-kid=\"1-3-2-2-1-2-1-1-2-2-1-2-1\" data-name=\"presentation price 2\">\n                                                    $ 1.250 - $ 4.700\n                                                </p>\n                                                <p class=\"text-sm text-slate-600\" data-kid=\"1-3-2-2-1-2-1-1-2-2-1-2-2\" data-name=\"presentation range label 2\">\n                                                    hasta 3,8 x de diferencia\n                                                </p>\n                                            </div>\n                                        </div>\n                                        <p class=\"mt-2 text-sm text-slate-600\" data-kid=\"1-3-2-2-1-2-1-1-2-2-2\" data-name=\"lowest price info 2\">\n                                            <strong class=\"font-semibold text-slate-800\" data-kid=\"1-3-2-2-1-2-1-1-2-2-2-1\" data-name=\"lowest price bold text 2\">\n                                                Más barato:\n                                            </strong>\n                                            IBUPROFENO ROSPAW 400 · Rospaw · $ 1.250\n                                        </p>\n                                    </li>\n                                    <li class=\"py-4\" data-kid=\"1-3-2-2-1-2-1-1-2-3\" data-name=\"presentation item 3\">\n                                        <div class=\"flex flex-wrap items-start justify-between gap-x-4 gap-y-2\" data-kid=\"1-3-2-2-1-2-1-1-2-3-1\" data-name=\"presentation item container 3\">\n                                            <div class=\"min-w-0\" data-kid=\"1-3-2-2-1-2-1-1-2-3-1-1\" data-name=\"presentation details 3\">\n                                                <p class=\"text-sm font-bold text-slate-900\" data-kid=\"1-3-2-2-1-2-1-1-2-3-1-1-1\" data-name=\"presentation name 3\">\n                                                    600 mg comp.x 10\n                                                </p>\n                                                <p class=\"mt-0.5 text-sm text-slate-600\" data-kid=\"1-3-2-2-1-2-1-1-2-3-1-1-2\" data-name=\"presentation type 3\">\n                                                    comprimido · vía oral\n                                                </p>\n                                            </div>\n                                            <div class=\"text-right\" data-kid=\"1-3-2-2-1-2-1-1-2-3-1-2\" data-name=\"presentation price range 3\">\n                                                <p class=\"text-lg font-extrabold tracking-tight text-slate-900\" data-kid=\"1-3-2-2-1-2-1-1-2-3-1-2-1\" data-name=\"presentation price 3\">\n                                                    $ 2.100 - $ 5.900\n                                                </p>\n                                                <p class=\"text-sm text-slate-600\" data-kid=\"1-3-2-2-1-2-1-1-2-3-1-2-2\" data-name=\"presentation range label 3\">\n                                                    hasta 2,8 x de diferencia\n                                                </p>\n                                            </div>\n                                        </div>\n                                        <p class=\"mt-2 text-sm text-slate-600\" data-kid=\"1-3-2-2-1-2-1-1-2-3-2\" data-name=\"lowest price info 3\">\n                                            <strong class=\"font-semibold text-slate-800\" data-kid=\"1-3-2-2-1-2-1-1-2-3-2-1\" data-name=\"lowest price bold text 3\">\n                                                Más barato:\n                                            </strong>\n                                            IBUPROFENO FECOFAR · Fecofar · $ 2.100\n                                        </p>\n                                    </li>\n                                </ul>\n                                <button class=\"mt-2 inline-flex min-h-11 items-center rounded-lg px-2 text-sm font-semibold text-sky-800\" data-kid=\"1-3-2-2-1-2-1-1-3\" data-name=\"view all presentations button\">\n                                    Ver las 78 presentaciones\n                                </button>\n                            </article>\n                        </li>\n                    </ul>\n                </section>\n                <aside aria-label=\"Directorio independiente de farmacias\" class=\"min-w-0 border-t border-slate-200 pt-6 lg:border-t-0 lg:pt-0\" data-kid=\"1-3-2-2-2\" data-name=\"pharmacy sidebar\">\n                    <section aria-labelledby=\"pharmacies-title\" data-kid=\"1-3-2-2-2-1\" data-name=\"pharmacies list section\">\n                        <h2 class=\"text-xl font-bold tracking-tight text-slate-950\" data-kid=\"1-3-2-2-2-1-1\" data-name=\"pharmacies title\" id=\"pharmacies-title\">\n                            Farmacias registradas en CABA\n                        </h2>\n                        <p class=\"mt-1.5 text-sm leading-6 text-slate-600\" data-kid=\"1-3-2-2-2-1-2\" data-name=\"pharmacies description\">\n                            El registro es independiente de la búsqueda; no informa precio ni stock. Llamá para consultar antes de ir.\n                        </p>\n                        <div class=\"mt-4 flex flex-col gap-2\" data-kid=\"1-3-2-2-2-1-3\" data-name=\"pharmacy filter container\">\n                            <label class=\"text-sm font-semibold text-slate-600\" data-kid=\"1-3-2-2-2-1-3-1\" data-name=\"filter label\" for=\"pharmacy-filter\">\n                                Filtrar farmacias\n                            </label>\n                            <input class=\"h-11 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm text-slate-900 placeholder:text-slate-500\" data-kid=\"1-3-2-2-2-1-3-2\" data-name=\"pharmacy filter input field\" id=\"pharmacy-filter\" placeholder=\"Barrio, comuna o nombre\" type=\"search\"/>\n                            <p class=\"text-sm text-slate-600\" data-kid=\"1-3-2-2-2-1-3-3\" data-name=\"pharmacy count info\">\n                                1.240 de 1.240\n                            </p>\n                        </div>\n                        <ul class=\"mt-4\" data-kid=\"1-3-2-2-2-1-4\" data-name=\"pharmacy list\">\n                            <li class=\"grid gap-3 border-t border-slate-200 py-4\" data-kid=\"1-3-2-2-2-1-4-1\" data-name=\"pharmacy item\">\n                                <div class=\"min-w-0\" data-kid=\"1-3-2-2-2-1-4-1-1\" data-name=\"pharmacy info\">\n                                    <h3 class=\"text-sm font-semibold text-slate-900\" data-kid=\"1-3-2-2-2-1-4-1-1-1\" data-name=\"pharmacy name\">\n                                        Farmacia (Cordoba Av. 2060)\n                                    </h3>\n                                    <p class=\"mt-1 text-sm leading-5 text-slate-600\" data-kid=\"1-3-2-2-2-1-4-1-1-2\" data-name=\"pharmacy address\">\n                                        Cordoba Av. 2060\n                                        <span class=\"text-slate-500\" data-kid=\"1-3-2-2-2-1-4-1-1-2-1\" data-name=\"pharmacy neighborhood\">\n                                            · Balvanera · Comuna 3\n                                        </span>\n                                    </p>\n                                </div>\n                                <div class=\"flex flex-wrap items-center gap-x-4 gap-y-2 text-sm\" data-kid=\"1-3-2-2-2-1-4-1-2\" data-name=\"pharmacy actions\">\n                                    <span class=\"text-slate-600\" data-kid=\"1-3-2-2-2-1-4-1-2-1\" data-name=\"location status\">\n                                        Sin ubicación activada\n                                    </span>\n                                    <a class=\"inline-flex min-h-11 items-center justify-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white\" data-kid=\"1-3-2-2-2-1-4-1-2-2\" data-name=\"view route button\" href=\"#\">\n                                        Abrir ruta\n                                    </a>\n                                </div>\n                            </li>\n                            <li class=\"grid gap-3 border-t border-slate-200 py-4\" data-kid=\"1-3-2-2-2-1-4-2\" data-name=\"pharmacy item 2\">\n                                <div class=\"min-w-0\" data-kid=\"1-3-2-2-2-1-4-2-1\" data-name=\"pharmacy info 2\">\n                                    <h3 class=\"text-sm font-semibold text-slate-900\" data-kid=\"1-3-2-2-2-1-4-2-1-1\" data-name=\"pharmacy name 2\">\n                                        Farmacia (Cordoba Av. 3200)\n                                    </h3>\n                                    <p class=\"mt-1 text-sm leading-5 text-slate-600\" data-kid=\"1-3-2-2-2-1-4-2-1-2\" data-name=\"pharmacy address 2\">\n                                        Cordoba Av. 3200\n                                        <span class=\"text-slate-500\" data-kid=\"1-3-2-2-2-1-4-2-1-2-1\" data-name=\"pharmacy neighborhood 2\">\n                                            · Balvanera · Comuna 3\n                                        </span>\n                                    </p>\n                                </div>\n                                <div class=\"flex flex-wrap items-center gap-x-4 gap-y-2 text-sm\" data-kid=\"1-3-2-2-2-1-4-2-2\" data-name=\"pharmacy actions 2\">\n                                    <span class=\"text-slate-600\" data-kid=\"1-3-2-2-2-1-4-2-2-1\" data-name=\"location status 2\">\n                                        En orden alfabético\n                                    </span>\n                                    <a class=\"inline-flex min-h-11 items-center justify-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white\" data-kid=\"1-3-2-2-2-1-4-2-2-2\" data-name=\"view route button 2\" href=\"#\">\n                                        Abrir ruta\n                                    </a>\n                                </div>\n                            </li>\n                        </ul>\n                        <button class=\"mt-2 inline-flex min-h-11 items-center gap-2 rounded-lg px-1 text-sm font-semibold text-sky-800\" data-kid=\"1-3-2-2-2-1-5\" data-name=\"view all pharmacies button\">\n                            <i class=\"ti ti-chevron-down\" data-kid=\"1-3-2-2-2-1-5-1\" data-name=\"chevron icon 2\">\n                            </i>\n                            Ver las 1.240 farmacias\n                        </button>\n                        <p class=\"mt-1 text-sm text-slate-500\" data-kid=\"1-3-2-2-2-1-6\" data-name=\"pharmacy list note\">\n                            Sin ubicación activada, la lista está en orden alfabético.\n                        </p>\n                    </section>\n                </aside>\n            </div>\n            <section aria-labelledby=\"related-title\" class=\"mt-9 border-t border-slate-200 pt-6\" data-kid=\"1-3-2-3\" data-name=\"related matches section\">\n                <div class=\"mb-3 border-b border-slate-200 pb-3\" data-kid=\"1-3-2-3-1\" data-name=\"related matches header\">\n                    <div class=\"flex items-baseline justify-between gap-4\" data-kid=\"1-3-2-3-1-1\" data-name=\"related matches title row\">\n                        <h3 class=\"text-base font-bold text-slate-800\" data-kid=\"1-3-2-3-1-1-1\" data-name=\"related matches title\" id=\"related-title\">\n                            Coincidencias relacionadas\n                        </h3>\n                        <span class=\"shrink-0 text-sm font-medium text-amber-800\" data-kid=\"1-3-2-3-1-1-2\" data-name=\"related matches count\">\n                            12 resultados\n                        </span>\n                    </div>\n                    <p class=\"mt-1 text-sm leading-6 text-slate-600\" data-kid=\"1-3-2-3-1-2\" data-name=\"related matches note\">\n                        Asociaciones y nombres afines; no son el mismo medicamento.\n                    </p>\n                </div>\n                <ul class=\"grid gap-4 lg:grid-cols-2\" data-kid=\"1-3-2-3-2\" data-name=\"related matches list\">\n                    <li data-kid=\"1-3-2-3-2-1\" data-name=\"related match item\">\n                        <article class=\"rounded-2xl border border-slate-200 bg-white p-4 shadow-sm\" data-kid=\"1-3-2-3-2-1-1\" data-name=\"related match card\">\n                            <span class=\"text-xs font-semibold text-amber-800\" data-kid=\"1-3-2-3-2-1-1-1\" data-name=\"related match category\">\n                                Asociación\n                            </span>\n                            <h4 class=\"mt-1.5 text-base font-bold text-slate-950\" data-kid=\"1-3-2-3-2-1-1-2\" data-name=\"related match name\">\n                                ibuprofeno + codeína\n                            </h4>\n                            <p class=\"mt-1 text-sm text-slate-600\" data-kid=\"1-3-2-3-2-1-1-3\" data-name=\"related match note\">\n                                Contiene más de un principio activo; no es el mismo producto que ibuprofeno solo.\n                            </p>\n                        </article>\n                    </li>\n                    <li data-kid=\"1-3-2-3-2-2\" data-name=\"related match item 2\">\n                        <article class=\"rounded-2xl border border-slate-200 bg-white p-4 shadow-sm\" data-kid=\"1-3-2-3-2-2-1\" data-name=\"related match card 2\">\n                            <span class=\"text-xs font-semibold text-amber-800\" data-kid=\"1-3-2-3-2-2-1-1\" data-name=\"related match category 2\">\n                                Asociación\n                            </span>\n                            <h4 class=\"mt-1.5 text-base font-bold text-slate-950\" data-kid=\"1-3-2-3-2-2-1-2\" data-name=\"related match name 2\">\n                                ibuprofeno + cafeína\n                            </h4>\n                            <p class=\"mt-1 text-sm text-slate-600\" data-kid=\"1-3-2-3-2-2-1-3\" data-name=\"related match note 2\">\n                                Resultado relacionado, separado de la coincidencia principal.\n                            </p>\n                        </article>\n                    </li>\n                </ul>\n            </section>\n            <section aria-labelledby=\"sources-title\" class=\"mt-10 border-t border-slate-200 pt-6\" data-kid=\"1-3-2-4\" data-name=\"sources section\">\n                <h2 class=\"text-base font-bold text-slate-800\" data-kid=\"1-3-2-4-1\" data-name=\"sources title\" id=\"sources-title\">\n                    Fuentes y limitaciones\n                </h2>\n                <div class=\"mt-3 grid gap-3 sm:grid-cols-2\" data-kid=\"1-3-2-4-2\" data-name=\"sources content\">\n                    <p class=\"text-sm leading-6 text-slate-600\" data-kid=\"1-3-2-4-2-1\" data-name=\"sources prices info\">\n                        <strong class=\"font-semibold text-slate-800\" data-kid=\"1-3-2-4-2-1-1\" data-name=\"sources prices bold\">\n                            Precios:\n                        </strong>\n                        referencia CNPM · catálogo parcial basado en una semilla PAMI.\n                    </p>\n                    <p class=\"text-sm leading-6 text-slate-600\" data-kid=\"1-3-2-4-2-2\" data-name=\"sources pharmacies info\">\n                        <strong class=\"font-semibold text-slate-800\" data-kid=\"1-3-2-4-2-2-1\" data-name=\"sources pharmacies bold\">\n                            Farmacias:\n                        </strong>\n                        registro de CABA independiente; no informa precio ni stock.\n                    </p>\n                </div>\n                <p class=\"mt-4 rounded-xl bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-950\" data-kid=\"1-3-2-4-3\" data-name=\"disclaimer warning\">\n                    Compará únicamente presentaciones iguales. Confirmá precio y disponibilidad directamente con la farmacia. No es consejo médico.\n                </p>\n            </section>\n        </section>\n    </main>\n    <footer class=\"border-t border-slate-200 bg-white\" data-kid=\"1-4\" data-name=\"footer section\">\n        <div class=\"mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-sm text-slate-500 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8\" data-kid=\"1-4-1\" data-name=\"footer container\">\n            <p data-kid=\"1-4-1-1\" data-name=\"footer copyright text\">\n                FarmaciaCerca · Versión alpha\n            </p>\n            <p data-kid=\"1-4-1-2\" data-name=\"footer disclaimer text\">\n                No es consejo médico. Confirmá precio y disponibilidad con la farmacia.\n            </p>\n        </div>\n    </footer>\n</div>\n",
