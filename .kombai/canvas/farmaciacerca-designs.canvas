      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen bg-slate-50 font-[Inter,ui-sans-serif,system-ui,sans-serif] text-slate-900\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b border-slate-200 bg-white\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"mx-auto max-w-4xl px-6 py-5\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <p class=\"text-xs font-bold uppercase tracking-[0.14em] text-sky-800\" data-kid=\"1-1-1-1\" data-name=\"product title label\">\n                FarmaciaCerca · Canvas\n            </p>\n            <h1 class=\"mt-1 text-3xl font-extrabold tracking-tight text-slate-950\" data-kid=\"1-1-1-2\" data-name=\"page headline\">\n                Vistas y estado\n            </h1>\n            <p class=\"mt-2 max-w-2xl text-sm leading-6 text-slate-600\" data-kid=\"1-1-1-3\" data-name=\"page description\">\n                Orden de trabajo de las vistas conservadas. El sello separa el antecedente beta de los estados usados en la app.\n            </p>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-4xl px-6 py-8\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"mb-5 flex flex-wrap items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm\" data-kid=\"1-2-1\" data-name=\"status legend container\">\n            <span class=\"rounded-full bg-amber-100 px-2.5 py-1 text-[11px] font-extrabold tracking-wide text-amber-900\" data-kid=\"1-2-1-1\" data-name=\"beta status badge\">\n                BETA\n            </span>\n            <span class=\"text-slate-600\" data-kid=\"1-2-1-2\" data-name=\"beta status label\">\n                Versión anterior\n            </span>\n            <span class=\"ml-2 rounded-full bg-emerald-100 px-2.5 py-1 text-[11px] font-extrabold tracking-wide text-emerald-900\" data-kid=\"1-2-1-3\" data-name=\"in use status badge\">\n                IN USE\n            </span>\n            <span class=\"text-slate-600\" data-kid=\"1-2-1-4\" data-name=\"in use status label\">\n                Estado actual en la implementación\n            </span>\n        </div>\n        <ol class=\"space-y-3\" data-kid=\"1-2-2\" data-name=\"views order list\">\n            <li class=\"rounded-2xl border border-amber-200 bg-white p-5 shadow-sm\" data-kid=\"1-2-2-1\" data-name=\"first view item\">\n                <div class=\"flex items-start gap-4\" data-kid=\"1-2-2-1-1\" data-name=\"first view wrapper\">\n                    <span class=\"flex size-9 shrink-0 items-center justify-center rounded-xl bg-amber-100 text-sm font-extrabold text-amber-900\" data-kid=\"1-2-2-1-1-1\" data-name=\"view number 01\">\n                        01\n                    </span>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-1-1-2\" data-name=\"view details container\">\n                        <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"view title row\">\n                            <h2 class=\"text-lg font-bold text-slate-950\" data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"view title\">\n                                Búsqueda primero\n                            </h2>\n                            <span class=\"rounded-full bg-amber-100 px-2.5 py-1 text-[10px] font-extrabold tracking-wide text-amber-900\" data-kid=\"1-2-2-1-1-2-1-2\" data-name=\"view beta status badge\">\n                                BETA\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-sm leading-5 text-slate-600\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"view description\">\n                            Antecedente desktop, conservado como referencia.\n                        </p>\n                    </div>\n                </div>\n            </li>\n            <li class=\"rounded-2xl border border-emerald-200 bg-white p-5 shadow-sm\" data-kid=\"1-2-2-2\" data-name=\"second view item\">\n                <div class=\"flex items-start gap-4\" data-kid=\"1-2-2-2-1\" data-name=\"second view wrapper\">\n                    <span class=\"flex size-9 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-sm font-extrabold text-emerald-900\" data-kid=\"1-2-2-2-1-1\" data-name=\"view number 02\">\n                        02\n                    </span>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-2-1-2\" data-name=\"view details container\">\n                        <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"view title row\">\n                            <h2 class=\"text-lg font-bold text-slate-950\" data-kid=\"1-2-2-2-1-2-1-1\" data-name=\"view title\">\n                                Dos tareas claras · resultados\n                            </h2>\n                            <span class=\"rounded-full bg-emerald-100 px-2.5 py-1 text-[10px] font-extrabold tracking-wide text-emerald-900\" data-kid=\"1-2-2-2-1-2-1-2\" data-name=\"view in use status badge\">\n                                IN USE\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-sm leading-5 text-slate-600\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"view description\">\n                            Desktop · principal, directorio CABA independiente, luego relacionadas.\n                        </p>\n                    </div>\n                </div>\n            </li>\n            <li class=\"rounded-2xl border border-emerald-200 bg-white p-5 shadow-sm\" data-kid=\"1-2-2-3\" data-name=\"third view item\">\n                <div class=\"flex items-start gap-4\" data-kid=\"1-2-2-3-1\" data-name=\"third view wrapper\">\n                    <span class=\"flex size-9 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-sm font-extrabold text-emerald-900\" data-kid=\"1-2-2-3-1-1\" data-name=\"view number 03\">\n                        03\n                    </span>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-3-1-2\" data-name=\"view details container\">\n                        <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"1-2-2-3-1-2-1\" data-name=\"view title row\">\n                            <h2 class=\"text-lg font-bold text-slate-950\" data-kid=\"1-2-2-3-1-2-1-1\" data-name=\"view title\">\n                                Dos tareas claras · sin resultados\n                            </h2>\n                            <span class=\"rounded-full bg-emerald-100 px-2.5 py-1 text-[10px] font-extrabold tracking-wide text-emerald-900\" data-kid=\"1-2-2-3-1-2-1-2\" data-name=\"view in use status badge\">\n                                IN USE\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-sm leading-5 text-slate-600\" data-kid=\"1-2-2-3-1-2-2\" data-name=\"view description\">\n                            Desktop · directorio permanece visible.\n                        </p>\n                    </div>\n                </div>\n            </li>\n            <li class=\"rounded-2xl border border-emerald-200 bg-white p-5 shadow-sm\" data-kid=\"1-2-2-4\" data-name=\"fourth view item\">\n                <div class=\"flex items-start gap-4\" data-kid=\"1-2-2-4-1\" data-name=\"fourth view wrapper\">\n                    <span class=\"flex size-9 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-sm font-extrabold text-emerald-900\" data-kid=\"1-2-2-4-1-1\" data-name=\"view number 04\">\n                        04\n                    </span>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-4-1-2\" data-name=\"view details container\">\n                        <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"1-2-2-4-1-2-1\" data-name=\"view title row\">\n                            <h2 class=\"text-lg font-bold text-slate-950\" data-kid=\"1-2-2-4-1-2-1-1\" data-name=\"view title\">\n                                Mobile · resultados\n                            </h2>\n                            <span class=\"rounded-full bg-emerald-100 px-2.5 py-1 text-[10px] font-extrabold tracking-wide text-emerald-900\" data-kid=\"1-2-2-4-1-2-1-2\" data-name=\"view in use status badge\">\n                                IN USE\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-sm leading-5 text-slate-600\" data-kid=\"1-2-2-4-1-2-2\" data-name=\"view description\">\n                            Mobile · principal → directorio → relacionadas.\n                        </p>\n                    </div>\n                </div>\n            </li>\n            <li class=\"rounded-2xl border border-emerald-200 bg-white p-5 shadow-sm\" data-kid=\"1-2-2-5\" data-name=\"fifth view item\">\n                <div class=\"flex items-start gap-4\" data-kid=\"1-2-2-5-1\" data-name=\"fifth view wrapper\">\n                    <span class=\"flex size-9 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-sm font-extrabold text-emerald-900\" data-kid=\"1-2-2-5-1-1\" data-name=\"view number 05\">\n                        05\n                    </span>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-5-1-2\" data-name=\"view details container\">\n                        <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"1-2-2-5-1-2-1\" data-name=\"view title row\">\n                            <h2 class=\"text-lg font-bold text-slate-950\" data-kid=\"1-2-2-5-1-2-1-1\" data-name=\"view title\">\n                                Mobile · sin resultados\n                            </h2>\n                            <span class=\"rounded-full bg-emerald-100 px-2.5 py-1 text-[10px] font-extrabold tracking-wide text-emerald-900\" data-kid=\"1-2-2-5-1-2-1-2\" data-name=\"view in use status badge\">\n                                IN USE\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-sm leading-5 text-slate-600\" data-kid=\"1-2-2-5-1-2-2\" data-name=\"view description\">\n                            Mobile · sin coincidencias, el directorio permanece.\n                        </p>\n                    </div>\n                </div>\n            </li>\n        </ol>\n        <aside class=\"mt-6 rounded-xl border border-slate-200 bg-slate-100 px-4 py-3 text-sm leading-5 text-slate-600\" data-kid=\"1-2-3\" data-name=\"qa test note\">\n            <strong class=\"font-semibold text-slate-800\" data-kid=\"1-2-3-1\" data-name=\"qa label\">\n                QA · test:layout\n            </strong>\n            valida la secuencia de resultados y el estado sin coincidencias.\n        </aside>\n    </main>\n</div>\n",
