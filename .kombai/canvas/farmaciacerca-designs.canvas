      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n  .font-inter { font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; }\n</style>\n<div class=\"font-inter min-h-screen bg-slate-50 text-slate-900\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"border-b border-amber-100 bg-amber-50 px-4 py-2 text-center text-xs font-bold uppercase tracking-wide text-amber-900\" data-kid=\"1-3\" data-name=\"beta notice bar\">\n        BETA · Versión anterior conservada como referencia\n    </div>\n    <header class=\"border-b border-slate-200 bg-white\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"mx-auto flex max-w-6xl items-center justify-between px-8 py-4\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <a aria-label=\"FarmaciaCerca, inicio\" class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand logo and title link\" href=\"#\">\n                <span class=\"flex size-11 items-center justify-center rounded-2xl bg-sky-600 text-white shadow-sm shadow-sky-900/15\" data-kid=\"1-1-1-1-1\" data-name=\"plus sign icon container\">\n                    <span class=\"text-[31px] font-light leading-none\" data-kid=\"1-1-1-1-1-1\" data-name=\"plus sign icon text\">\n                        +\n                    </span>\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"brand name and subtitle container\">\n                    <span class=\"block text-[15px] font-extrabold tracking-tight text-slate-950\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand title\">\n                        FarmaciaCerca\n                    </span>\n                    <span class=\"mt-0.5 block text-[12px] font-medium text-slate-500\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand subtitle\">\n                        Precio de referencia · Ministerio de Salud\n                    </span>\n                </span>\n            </a>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-2\" data-name=\"header actions container\">\n                <button aria-label=\"Cambiar tema\" class=\"flex size-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600\" data-kid=\"1-1-1-2-1\" data-name=\"toggle theme button\">\n                    <i class=\"ti ti-moon text-xl\" data-kid=\"1-1-1-2-1-1\" data-name=\"moon icon\">\n                    </i>\n                </button>\n                <button class=\"inline-flex h-10 items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700\" data-kid=\"1-1-1-2-2\" data-name=\"use location button\">\n                    <i class=\"ti ti-map-pin text-lg text-sky-700\" data-kid=\"1-1-1-2-2-1\" data-name=\"map pin icon\">\n                    </i>\n                    Usar mi ubicación\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-6xl px-8 pb-14 pt-10\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-labelledby=\"search-title\" data-kid=\"1-2-1\" data-name=\"search section\">\n            <div class=\"max-w-3xl\" data-kid=\"1-2-1-1\" data-name=\"search header container\">\n                <h1 class=\"text-[34px] font-extrabold leading-tight tracking-[-0.035em] text-slate-950\" data-kid=\"1-2-1-1-1\" data-name=\"search headline\" id=\"search-title\">\n                    Buscá por principio activo o nombre comercial\n                </h1>\n                <p class=\"mt-2 text-[15px] leading-6 text-slate-600\" data-kid=\"1-2-1-1-2\" data-name=\"search subheadline\">\n                    Compará precios de referencia entre laboratorios para una misma presentación.\n                </p>\n            </div>\n            <div class=\"mt-6 flex items-center gap-3 rounded-2xl border border-slate-200 bg-white p-3 shadow-sm shadow-slate-900/5\" data-kid=\"1-2-1-2\" data-name=\"search input container\">\n                <i class=\"ti ti-search ml-2 text-[22px] text-slate-400\" data-kid=\"1-2-1-2-1\" data-name=\"search icon\">\n                </i>\n                <input aria-label=\"Buscar medicamento\" class=\"h-12 min-w-0 flex-1 bg-transparent px-1 text-[17px] font-medium text-slate-900 outline-none placeholder:text-slate-400\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2\" data-name=\"search text input field\" data-reason=\"value initialized by client-side state/query\" value=\"ibuprofeno\"/>\n                <button class=\"inline-flex h-11 items-center gap-2 rounded-xl px-4 text-sm font-semibold text-slate-500 hover:bg-slate-50\" data-kid=\"1-2-1-2-3\" data-name=\"clear search button\">\n                    <i class=\"ti ti-x text-lg\" data-kid=\"1-2-1-2-3-1\" data-name=\"x close icon\">\n                    </i>\n                    Limpiar\n                </button>\n            </div>\n            <div class=\"mt-3 flex flex-wrap items-center gap-x-6 gap-y-2 text-[13px] leading-5 text-slate-600\" data-kid=\"1-2-1-3\" data-name=\"search metadata tags container\">\n                <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-3-1\" data-name=\"catalog info tag\">\n                    <i class=\"ti ti-database text-base text-sky-700\" data-kid=\"1-2-1-3-1-1\" data-name=\"database icon\">\n                    </i>\n                    Catálogo parcial · 1.923 productos\n                </span>\n                <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-3-2\" data-name=\"disclaimer price tag\">\n                    <i class=\"ti ti-currency-dollar text-base text-sky-700\" data-kid=\"1-2-1-3-2-1\" data-name=\"dollar currency icon\">\n                    </i>\n                    Precios de referencia, no precios de farmacia\n                </span>\n                <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-3-3\" data-name=\"pharmacy coverage tag\">\n                    <i class=\"ti ti-map-pin text-base text-sky-700\" data-kid=\"1-2-1-3-3-1\" data-name=\"map pin icon\">\n                    </i>\n                    Farmacias registradas en CABA · sin datos de stock\n                </span>\n                <span class=\"text-slate-400\" data-kid=\"1-2-1-3-4\" data-name=\"source and date info text\">\n                    Fuente CNPM · vigencia 01/10/2026\n                </span>\n            </div>\n        </section>\n        <section aria-labelledby=\"results-title\" class=\"mt-10\" data-kid=\"1-2-2\" data-name=\"search results section\">\n            <div class=\"flex items-end justify-between gap-8 border-b border-slate-200 pb-5\" data-kid=\"1-2-2-1\" data-name=\"results header bar\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"results title container\">\n                    <h2 class=\"text-[27px] font-bold leading-tight tracking-[-0.025em] text-slate-950\" data-kid=\"1-2-2-1-1-1\" data-name=\"results title\" id=\"results-title\">\n                        13 composiciones para “ibuprofeno”\n                    </h2>\n                    <p class=\"mt-2 text-sm text-slate-600\" data-kid=\"1-2-2-1-1-2\" data-name=\"results coincidence status text\">\n                        <span class=\"font-semibold text-slate-900\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"exact coincidence label\">\n                            1 coincidencia exacta\n                        </span>\n                        <span class=\"mx-2 text-slate-300\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"separator dot\">\n                            ·\n                        </span>\n                        12 relacionadas\n                    </p>\n                </div>\n                <div class=\"w-[280px] shrink-0\" data-kid=\"1-2-2-1-2\" data-name=\"sorting control container\">\n                    <label class=\"mb-1.5 block text-xs font-semibold text-slate-500\" data-kid=\"1-2-2-1-2-1\" data-name=\"sort label\" for=\"sort\">\n                        Ordenar resultados\n                    </label>\n                    <select class=\"h-11 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm font-medium text-slate-700\" data-kid=\"1-2-2-1-2-2\" data-name=\"sort select dropdown\" id=\"sort\">\n                        <option data-kid=\"1-2-2-1-2-2-1\" data-name=\"sort option\">\n                            Precio más bajo primero\n                        </option>\n                    </select>\n                </div>\n            </div>\n            <div class=\"mt-6 grid grid-cols-[minmax(0,1fr)_290px] gap-8\" data-kid=\"1-2-2-2\" data-name=\"results layout grid\">\n                <div data-kid=\"1-2-2-2-1\" data-name=\"exact match area\">\n                    <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-2-2-2-1-1\" data-name=\"exact match header\">\n                        <h3 class=\"text-[14px] font-bold text-slate-700\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"exact match title\">\n                            Coincidencia exacta\n                        </h3>\n                        <span class=\"text-[13px] text-slate-500\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"exact match subtitle\">\n                            Principio activo\n                        </span>\n                    </div>\n                    <article class=\"overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm shadow-slate-900/5\" data-kid=\"1-2-2-2-1-2\" data-name=\"exact match result card\">\n                        <div class=\"flex items-start justify-between gap-6 px-6 py-5\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"result info top bar\">\n                            <div data-kid=\"1-2-2-2-1-2-1-1\" data-name=\"result identification container\">\n                                <h4 class=\"text-[25px] font-bold tracking-tight text-slate-950\" data-kid=\"1-2-2-2-1-2-1-1-1\" data-name=\"result drug name\">\n                                    ibuprofeno\n                                </h4>\n                                <p class=\"mt-1.5 text-sm text-slate-600\" data-kid=\"1-2-2-2-1-2-1-1-2\" data-name=\"result product count text\">\n                                    159 productos en 78 presentaciones\n                                </p>\n                            </div>\n                            <div class=\"text-right\" data-kid=\"1-2-2-2-1-2-1-2\" data-name=\"price reference block\">\n                                <p class=\"text-xs font-semibold uppercase tracking-[0.12em] text-slate-500\" data-kid=\"1-2-2-2-1-2-1-2-1\" data-name=\"price reference label\">\n                                    Desde · referencia\n                                </p>\n                                <p class=\"mt-1 text-2xl font-extrabold tracking-tight text-sky-800\" data-kid=\"1-2-2-2-1-2-1-2-2\" data-name=\"minimum reference price\">\n                                    $ 663\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"border-y border-slate-200 bg-slate-50/80 px-6 py-4\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"result comparison details\">\n                            <div class=\"flex flex-wrap items-baseline justify-between gap-3\" data-kid=\"1-2-2-2-1-2-2-1\" data-name=\"comparison grid\">\n                                <div data-kid=\"1-2-2-2-1-2-2-1-1\" data-name=\"comparison presentation container\">\n                                    <p class=\"text-[12px] font-semibold uppercase tracking-[0.12em] text-slate-500\" data-kid=\"1-2-2-2-1-2-2-1-1-1\" data-name=\"presentation label\">\n                                        Presentación comparable\n                                    </p>\n                                    <h5 class=\"mt-1 text-[17px] font-bold text-slate-900\" data-kid=\"1-2-2-2-1-2-2-1-1-2\" data-name=\"presentation type text\">\n                                        Suspensión oral · 90 ml\n                                    </h5>\n                                </div>\n                                <div class=\"text-right\" data-kid=\"1-2-2-2-1-2-2-1-2\" data-name=\"reference range container\">\n                                    <p class=\"text-xs text-slate-500\" data-kid=\"1-2-2-2-1-2-2-1-2-1\" data-name=\"range label\">\n                                        Rango de referencia entre laboratorios\n                                    </p>\n                                    <p class=\"mt-0.5 text-[20px] font-bold tracking-tight text-slate-950\" data-kid=\"1-2-2-2-1-2-2-1-2-2\" data-name=\"price range\">\n                                        $ 663\n                                        <span class=\"font-normal text-slate-400\" data-kid=\"1-2-2-2-1-2-2-1-2-2-1\" data-name=\"range separator\">\n                                            —\n                                        </span>\n                                        $ 12.608\n                                    </p>\n                                </div>\n                            </div>\n                            <p class=\"mt-3 max-w-3xl text-[13px] leading-5 text-slate-600\" data-kid=\"1-2-2-2-1-2-2-2\" data-name=\"comparison disclaimer\">\n                                El rango compara productos de esta misma presentación. No indica el precio ni la disponibilidad en una farmacia.\n                            </p>\n                        </div>\n                        <div class=\"px-6 pb-2 pt-4\" data-kid=\"1-2-2-2-1-2-3\" data-name=\"product list section\">\n                            <div class=\"grid grid-cols-[minmax(0,1fr)_190px_150px] gap-4 pb-2 text-[12px] font-semibold uppercase tracking-[0.08em] text-slate-500\" data-kid=\"1-2-2-2-1-2-3-1\" data-name=\"list header row\">\n                                <span data-kid=\"1-2-2-2-1-2-3-1-1\" data-name=\"product header\">\n                                    Producto\n                                </span>\n                                <span data-kid=\"1-2-2-2-1-2-3-1-2\" data-name=\"laboratory header\">\n                                    Laboratorio\n                                </span>\n                                <span class=\"text-right\" data-kid=\"1-2-2-2-1-2-3-1-3\" data-name=\"price header\">\n                                    Precio de referencia\n                                </span>\n                            </div>\n                            <div class=\"grid grid-cols-[minmax(0,1fr)_190px_150px] items-center gap-4 border-t border-slate-100 py-3.5 text-sm\" data-kid=\"1-2-2-2-1-2-3-2\" data-name=\"product item row 1\">\n                                <span class=\"font-semibold text-slate-900\" data-kid=\"1-2-2-2-1-2-3-2-1\" data-name=\"product name 1\">\n                                    IBUPROFENO FECOFAR\n                                </span>\n                                <span class=\"text-slate-600\" data-kid=\"1-2-2-2-1-2-3-2-2\" data-name=\"laboratory name 1\">\n                                    Fecofar\n                                </span>\n                                <span class=\"text-right text-[15px] font-bold text-slate-950\" data-kid=\"1-2-2-2-1-2-3-2-3\" data-name=\"price 1\">\n                                    $ 663\n                                </span>\n                            </div>\n                            <div class=\"grid grid-cols-[minmax(0,1fr)_190px_150px] items-center gap-4 border-t border-slate-100 py-3.5 text-sm\" data-kid=\"1-2-2-2-1-2-3-3\" data-name=\"product item row 2\">\n                                <span class=\"font-medium text-slate-800\" data-kid=\"1-2-2-2-1-2-3-3-1\" data-name=\"product name 2\">\n                                    IBU APRACUR\n                                </span>\n                                <span class=\"text-slate-600\" data-kid=\"1-2-2-2-1-2-3-3-2\" data-name=\"laboratory name 2\">\n                                    Austral\n                                </span>\n                                <span class=\"text-right font-semibold text-slate-800\" data-kid=\"1-2-2-2-1-2-3-3-3\" data-name=\"price 2\">\n                                    $ 5.570\n                                </span>\n                            </div>\n                            <div class=\"grid grid-cols-[minmax(0,1fr)_190px_150px] items-center gap-4 border-t border-slate-100 py-3.5 text-sm\" data-kid=\"1-2-2-2-1-2-3-4\" data-name=\"product item row 3\">\n                                <span class=\"font-medium text-slate-800\" data-kid=\"1-2-2-2-1-2-3-4-1\" data-name=\"product name 3\">\n                                    IBUFEC 2%\n                                </span>\n                                <span class=\"text-slate-600\" data-kid=\"1-2-2-2-1-2-3-4-2\" data-name=\"laboratory name 3\">\n                                    Fecofar\n                                </span>\n                                <span class=\"text-right font-semibold text-slate-800\" data-kid=\"1-2-2-2-1-2-3-4-3\" data-name=\"price 3\">\n                                    $ 6.633\n                                </span>\n                            </div>\n                            <div class=\"grid grid-cols-[minmax(0,1fr)_190px_150px] items-center gap-4 border-t border-slate-100 py-3.5 text-sm\" data-kid=\"1-2-2-2-1-2-3-5\" data-name=\"product item row 4\">\n                                <span class=\"font-medium text-slate-800\" data-kid=\"1-2-2-2-1-2-3-5-1\" data-name=\"product name 4\">\n                                    IBUFEC 4%\n                                </span>\n                                <span class=\"text-slate-600\" data-kid=\"1-2-2-2-1-2-3-5-2\" data-name=\"laboratory name 4\">\n                                    Fecofar\n                                </span>\n                                <span class=\"text-right font-semibold text-slate-800\" data-kid=\"1-2-2-2-1-2-3-5-3\" data-name=\"price 4\">\n                                    $ 10.066\n                                </span>\n                            </div>\n                            <div class=\"grid grid-cols-[minmax(0,1fr)_190px_150px] items-center gap-4 border-t border-slate-100 py-3.5 text-sm\" data-kid=\"1-2-2-2-1-2-3-6\" data-name=\"product item row 5\">\n                                <span class=\"font-medium text-slate-800\" data-kid=\"1-2-2-2-1-2-3-6-1\" data-name=\"product name 5\">\n                                    IBUMEJORAL NIÑOS 4%\n                                </span>\n                                <span class=\"text-slate-600\" data-kid=\"1-2-2-2-1-2-3-6-2\" data-name=\"laboratory name 5\">\n                                    Laboratorio Gramon\n                                </span>\n                                <span class=\"text-right font-semibold text-slate-800\" data-kid=\"1-2-2-2-1-2-3-6-3\" data-name=\"price 5\">\n                                    $ 12.608\n                                </span>\n                            </div>\n                            <div class=\"border-t border-slate-100 py-3 text-[13px] font-medium text-slate-500\" data-kid=\"1-2-2-2-1-2-3-7\" data-name=\"see more laboratories button\">\n                                5 laboratorios para esta presentación\n                            </div>\n                        </div>\n                    </article>\n                    <div class=\"mt-6 flex items-center justify-between border-b border-slate-200 pb-3\" data-kid=\"1-2-2-2-1-3\" data-name=\"related matches header\">\n                        <div data-kid=\"1-2-2-2-1-3-1\" data-name=\"related matches title container\">\n                            <h3 class=\"text-[14px] font-bold text-slate-700\" data-kid=\"1-2-2-2-1-3-1-1\" data-name=\"related matches title\">\n                                Coincidencias relacionadas\n                            </h3>\n                            <p class=\"mt-1 text-[13px] text-slate-500\" data-kid=\"1-2-2-2-1-3-1-2\" data-name=\"related matches subtitle\">\n                                Asociaciones y nombres afines; no son el mismo medicamento.\n                            </p>\n                        </div>\n                        <span class=\"rounded-lg bg-amber-50 px-2.5 py-1 text-[12px] font-semibold text-amber-800\" data-kid=\"1-2-2-2-1-3-2\" data-name=\"related results badge\">\n                            12 resultados\n                        </span>\n                    </div>\n                </div>\n                <aside class=\"pt-1\" data-kid=\"1-2-2-2-2\" data-name=\"results sidebar\">\n                    <div class=\"sticky top-5\" data-kid=\"1-2-2-2-2-1\" data-name=\"sidebar content container\">\n                        <div class=\"border-l-2 border-sky-600 pl-4\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"sidebar info block\">\n                            <h3 class=\"text-[15px] font-bold text-slate-900\" data-kid=\"1-2-2-2-2-1-1-1\" data-name=\"sidebar info title\">\n                                Qué muestran estos precios\n                            </h3>\n                            <p class=\"mt-2 text-[13px] leading-5 text-slate-600\" data-kid=\"1-2-2-2-2-1-1-2\" data-name=\"sidebar info text 1\">\n                                Son valores de referencia del Vademécum Nacional, no precios confirmados por una farmacia.\n                            </p>\n                            <p class=\"mt-3 text-[13px] leading-5 text-slate-600\" data-kid=\"1-2-2-2-2-1-1-3\" data-name=\"sidebar info text 2\">\n                                La comparación solo es válida entre laboratorios de la misma presentación. No se informa stock.\n                            </p>\n                        </div>\n                        <div class=\"mt-6 border-t border-slate-200 pt-4\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"source info block\">\n                            <p class=\"text-[12px] font-semibold uppercase tracking-[0.1em] text-slate-500\" data-kid=\"1-2-2-2-2-1-2-1\" data-name=\"source label\">\n                                Fuente y vigencia\n                            </p>\n                            <p class=\"mt-2 text-[13px] font-medium leading-5 text-slate-800\" data-kid=\"1-2-2-2-2-1-2-2\" data-name=\"source institution name\">\n                                CNPM · Ministerio de Salud\n                            </p>\n                            <p class=\"mt-1 text-[13px] text-slate-600\" data-kid=\"1-2-2-2-2-1-2-3\" data-name=\"source effective date\">\n                                Vigente al 01/10/2026\n                            </p>\n                            <p class=\"mt-3 text-[13px] leading-5 text-slate-500\" data-kid=\"1-2-2-2-2-1-2-4\" data-name=\"source disclaimer\">\n                                Catálogo parcial basado en medicamentos del ranking PAMI. No es el Vademécum completo.\n                            </p>\n                        </div>\n                    </div>\n                </aside>\n            </div>\n        </section>\n        <section aria-labelledby=\"pharmacies-title\" class=\"mt-10 border-t border-slate-200 pt-6\" data-kid=\"1-2-3\" data-name=\"pharmacy lookup section\">\n            <div class=\"flex items-start justify-between gap-8\" data-kid=\"1-2-3-1\" data-name=\"pharmacies header\">\n                <div data-kid=\"1-2-3-1-1\" data-name=\"pharmacies header container\">\n                    <h2 class=\"text-[21px] font-bold tracking-tight text-slate-950\" data-kid=\"1-2-3-1-1-1\" data-name=\"pharmacies section title\" id=\"pharmacies-title\">\n                        Farmacias registradas en CABA\n                    </h2>\n                    <p class=\"mt-1.5 text-[13px] leading-5 text-slate-600\" data-kid=\"1-2-3-1-1-2\" data-name=\"pharmacies section subtitle\">\n                        El registro no informa precio ni stock. Llamá para consultar antes de ir.\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"1-2-3-1-2\" data-name=\"pharmacies filter container\">\n                    <label class=\"sr-only\" data-kid=\"1-2-3-1-2-1\" data-name=\"filter label\" for=\"pharmacy-filter\">\n                        Filtrar farmacias\n                    </label>\n                    <input class=\"h-10 w-[260px] rounded-xl border border-slate-200 bg-white px-3 text-[13px] text-slate-800 placeholder:text-slate-400\" data-kid=\"1-2-3-1-2-2\" data-name=\"filter input field\" id=\"pharmacy-filter\" placeholder=\"Barrio, comuna o nombre\"/>\n                    <span class=\"text-[13px] text-slate-500\" data-kid=\"1-2-3-1-2-3\" data-name=\"pharmacy count label\">\n                        1.240 farmacias\n                    </span>\n                </div>\n            </div>\n            <div class=\"mt-4 grid grid-cols-[1.3fr_1fr_1fr_auto] items-center gap-4 border-y border-slate-200 py-4\" data-kid=\"1-2-3-2\" data-name=\"pharmacy item row\">\n                <div data-kid=\"1-2-3-2-1\" data-name=\"pharmacy info container\">\n                    <p class=\"text-sm font-semibold text-slate-900\" data-kid=\"1-2-3-2-1-1\" data-name=\"pharmacy name\">\n                        Farmacia Schapira\n                    </p>\n                    <p class=\"mt-1 text-[13px] text-slate-600\" data-kid=\"1-2-3-2-1-2\" data-name=\"pharmacy address\">\n                        Saladillo 2395 · Mataderos · Comuna 9\n                    </p>\n                </div>\n                <div class=\"text-[13px] text-slate-600\" data-kid=\"1-2-3-2-2\" data-name=\"pharmacy phone number\">\n                    <i class=\"ti ti-phone mr-1.5 text-base text-slate-400\" data-kid=\"1-2-3-2-2-1\" data-name=\"phone icon\">\n                    </i>\n                    4687-0599\n                </div>\n                <div class=\"text-[13px] text-slate-500\" data-kid=\"1-2-3-2-3\" data-name=\"pharmacy distance status\">\n                    Distancia disponible al activar ubicación\n                </div>\n                <div class=\"flex items-center gap-2\" data-kid=\"1-2-3-2-4\" data-name=\"pharmacy action buttons container\">\n                    <a class=\"inline-flex h-9 items-center gap-1.5 rounded-lg border border-slate-300 px-3 text-[13px] font-semibold text-slate-700\" data-kid=\"1-2-3-2-4-1\" data-name=\"call button\" href=\"tel:46870599\">\n                        <i class=\"ti ti-phone text-base\" data-kid=\"1-2-3-2-4-1-1\" data-name=\"phone icon\">\n                        </i>\n                        Llamar\n                    </a>\n                    <a class=\"inline-flex h-9 items-center gap-1.5 rounded-lg bg-slate-900 px-3 text-[13px] font-semibold text-white\" data-kid=\"1-2-3-2-4-2\" data-name=\"directions button\" href=\"#\">\n                        <i class=\"ti ti-directions text-base\" data-kid=\"1-2-3-2-4-2-1\" data-name=\"directions icon\">\n                        </i>\n                        Abrir ruta\n                    </a>\n                </div>\n            </div>\n            <button class=\"mt-4 text-[13px] font-semibold text-sky-800\" data-kid=\"1-2-3-3\" data-name=\"view all pharmacies button\">\n                Ver todas las farmacias\n                <i class=\"ti ti-arrow-right ml-1 text-sm\" data-kid=\"1-2-3-3-1\" data-name=\"arrow icon\">\n                </i>\n            </button>\n        </section>\n        <footer class=\"mt-12 flex items-center justify-between border-t border-slate-200 pt-5 text-[12px] text-slate-500\" data-kid=\"1-2-4\" data-name=\"footer section\">\n            <p data-kid=\"1-2-4-1\" data-name=\"footer copyright text\">\n                FarmaciaCerca · Datos del Vademécum Nacional de Medicamentos\n            </p>\n            <p data-kid=\"1-2-4-2\" data-name=\"footer notice text\">\n                No es consejo médico. Confirmá precio y disponibilidad con la farmacia.\n            </p>\n        </footer>\n    </main>\n</div>\n",
