      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen bg-slate-50 font-[Inter,ui-sans-serif,system-ui,sans-serif] text-slate-900\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"border-b border-emerald-100 bg-emerald-50 px-4 py-2 text-center text-xs font-bold uppercase tracking-wide text-emerald-900\" data-kid=\"1-2\" data-name=\"status bar notification banner\">\n        IN USE · VISTA DESKTOP SIN RESULTADOS IMPLEMENTADA\n    </div>\n    <header class=\"border-b border-slate-200 bg-white\" data-kid=\"1-1\" data-name=\"navigation header\">\n        <div class=\"mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6 lg:px-8\" data-kid=\"1-1-1\" data-name=\"navigation inner container\">\n            <a aria-label=\"FarmaciaCerca, inicio\" class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand logo and name link\" href=\"#\">\n                <span class=\"flex size-10 items-center justify-center rounded-xl bg-sky-600 text-white shadow-sm shadow-sky-900/15\" data-kid=\"1-1-1-1-1\" data-name=\"brand icon container\">\n                    <span class=\"text-[30px] font-light leading-none\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand icon plus symbol\">\n                        +\n                    </span>\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"brand name and subtitle container\">\n                    <span class=\"block text-sm font-extrabold tracking-tight text-slate-950\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name text\">\n                        FarmaciaCerca\n                    </span>\n                    <span class=\"mt-0.5 block text-xs font-medium text-slate-600\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand subtitle text\">\n                        Precio de referencia · Ministerio de Salud\n                    </span>\n                </span>\n            </a>\n            <div class=\"flex items-center gap-2 sm:gap-3\" data-kid=\"1-1-1-2\" data-name=\"navigation controls container\">\n                <button aria-label=\"Cambiar tema\" class=\"flex size-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600\" data-kid=\"1-1-1-2-1\" data-name=\"theme toggle button\">\n                    <i class=\"ti ti-moon text-lg\" data-kid=\"1-1-1-2-1-1\" data-name=\"moon icon\">\n                    </i>\n                </button>\n                <button class=\"inline-flex min-h-11 items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 text-xs font-bold text-slate-700 sm:px-4 sm:text-sm\" data-kid=\"1-1-1-2-2\" data-name=\"location toggle button\">\n                    <i class=\"ti ti-map-pin text-base\" data-kid=\"1-1-1-2-2-1\" data-name=\"map pin icon\">\n                    </i>\n                    <span class=\"hidden sm:inline\" data-kid=\"1-1-1-2-2-2\" data-name=\"location button text full\">\n                        Usar mi ubicación\n                    </span>\n                    <span class=\"sm:hidden\" data-kid=\"1-1-1-2-2-3\" data-name=\"location button text short\">\n                        Ubicación\n                    </span>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-6xl px-4 pb-12 pt-8 sm:px-6 sm:pt-10 lg:px-8\" data-kid=\"1-4\" data-name=\"main content section\">\n        <section aria-labelledby=\"search-title\" data-kid=\"1-4-1\" data-name=\"search section\">\n            <div class=\"max-w-4xl\" data-kid=\"1-4-1-1\" data-name=\"search heading and description container\">\n                <h1 class=\"text-3xl font-extrabold leading-tight tracking-tight text-slate-950 sm:text-4xl\" data-kid=\"1-4-1-1-1\" data-name=\"search heading text\" id=\"search-title\">\n                    Buscá por principio activo o nombre comercial\n                </h1>\n                <p class=\"mt-2 text-base leading-6 text-slate-600\" data-kid=\"1-4-1-1-2\" data-name=\"search description text\">\n                    Compará precios de referencia entre laboratorios para una misma presentación.\n                </p>\n            </div>\n            <div class=\"mt-6 flex items-center gap-2 rounded-2xl border border-slate-200 bg-white p-1.5 shadow-sm shadow-slate-900/5\" data-kid=\"1-4-1-2\" data-name=\"search input group\">\n                <i class=\"ti ti-search ml-3 text-xl text-slate-400\" data-kid=\"1-4-1-2-1\" data-name=\"search icon\">\n                </i>\n                <label class=\"sr-only\" data-kid=\"1-4-1-2-2\" data-name=\"search input label\" for=\"medicine-search\">\n                    Buscar por principio activo o nombre comercial\n                </label>\n                <input class=\"h-12 min-w-0 flex-1 bg-transparent px-1 text-base text-slate-900 outline-none placeholder:text-slate-400\" data-dynamic=\"true\" data-kid=\"1-4-1-2-3\" data-name=\"search input field\" data-reason=\"value initialized by script or user input\" id=\"medicine-search\" placeholder=\"Ej. ibuprofeno, paracetamol, Actron\" type=\"search\" value=\"xyzqqq\"/>\n                <button aria-label=\"Limpiar búsqueda\" class=\"inline-flex min-h-11 items-center gap-2 rounded-xl px-3 text-sm font-semibold text-slate-600\" data-kid=\"1-4-1-2-4\" data-name=\"search clear button\">\n                    <i class=\"ti ti-x text-base\" data-kid=\"1-4-1-2-4-1\" data-name=\"x icon\">\n                    </i>\n                    <span class=\"hidden sm:inline\" data-kid=\"1-4-1-2-4-2\" data-name=\"clear button text\">\n                        Limpiar\n                    </span>\n                </button>\n            </div>\n            <p class=\"mt-2.5 text-sm leading-5 text-slate-500\" data-kid=\"1-4-1-3\" data-name=\"search info text\">\n                El precio se compara entre laboratorios de una misma presentación.\n            </p>\n            <p class=\"mt-2 border-b border-slate-200 pb-5 text-sm text-slate-600\" data-kid=\"1-4-1-4\" data-name=\"catalog info paragraph\">\n                <strong class=\"font-semibold text-slate-800\" data-kid=\"1-4-1-4-1\" data-name=\"catalog count text\">\n                    Catálogo parcial\n                </strong>\n                · 1.923 productos\n            </p>\n        </section>\n        <section aria-labelledby=\"results-title\" class=\"mt-8\" data-kid=\"1-4-2\" data-name=\"results section\">\n            <div class=\"mb-4 flex flex-col gap-3 border-b border-slate-200 pb-4 sm:flex-row sm:items-end sm:justify-between\" data-kid=\"1-4-2-1\" data-name=\"results header container\">\n                <div data-kid=\"1-4-2-1-1\" data-name=\"results title container\">\n                    <h2 class=\"text-2xl font-bold tracking-tight text-slate-950\" data-dynamic=\"true\" data-kid=\"1-4-2-1-1-1\" data-name=\"results title text\" data-reason=\"text dynamic based on search query\" id=\"results-title\">\n                        Sin resultados para “xyzqqq”\n                    </h2>\n                </div>\n            </div>\n            <div class=\"min-w-0\" data-kid=\"1-4-2-2\" data-name=\"no results state container\">\n                <div class=\"flex flex-col items-start gap-3 border-b border-slate-200 py-5 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-4-2-2-1\" data-name=\"no results message\" role=\"status\">\n                    <div data-kid=\"1-4-2-2-1-1\" data-name=\"no results heading\">\n                        <h3 class=\"text-base font-bold text-slate-900\" data-kid=\"1-4-2-2-1-1-1\" data-name=\"no results heading text\">\n                            No encontramos coincidencias\n                        </h3>\n                        <p class=\"mt-1 max-w-xl text-sm leading-6 text-slate-600\" data-kid=\"1-4-2-2-1-1-2\" data-name=\"no results subtext\">\n                            Probá con el principio activo o con el nombre comercial. El catálogo disponible es parcial.\n                        </p>\n                    </div>\n                    <button class=\"min-h-11 shrink-0 rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700\" data-kid=\"1-4-2-2-1-2\" data-name=\"no results clear button\">\n                        Limpiar búsqueda\n                    </button>\n                </div>\n            </div>\n            <section aria-label=\"Directorio de farmacias\" class=\"mt-8 border-t border-slate-200 pt-6\" data-kid=\"1-4-2-3\" data-name=\"pharmacy directory section\">\n                <div class=\"mb-6 flex items-start gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3.5\" data-kid=\"1-4-2-3-1\" data-name=\"location prompt container\">\n                    <i class=\"ti ti-map-pin mt-0.5 text-lg text-slate-500\" data-kid=\"1-4-2-3-1-1\" data-name=\"location pin icon\">\n                    </i>\n                    <div data-kid=\"1-4-2-3-1-2\" data-name=\"location prompt message\">\n                        <p class=\"text-sm font-semibold text-slate-800\" data-kid=\"1-4-2-3-1-2-1\" data-name=\"location prompt heading\">\n                            Ubicación desactivada\n                        </p>\n                        <p class=\"mt-0.5 text-sm leading-5 text-slate-600\" data-kid=\"1-4-2-3-1-2-2\" data-name=\"location prompt text\">\n                            Activá tu ubicación para saber qué farmacia te queda más cerca.\n                        </p>\n                    </div>\n                </div>\n                <section aria-labelledby=\"pharmacies-title\" class=\"pt-1\" data-kid=\"1-4-2-3-2\" data-name=\"pharmacy list section\">\n                    <div class=\"flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between\" data-kid=\"1-4-2-3-2-1\" data-name=\"pharmacy list header\">\n                        <div data-kid=\"1-4-2-3-2-1-1\" data-name=\"pharmacy list title container\">\n                            <h2 class=\"text-2xl font-bold tracking-tight text-slate-950\" data-kid=\"1-4-2-3-2-1-1-1\" data-name=\"pharmacy list title\" id=\"pharmacies-title\">\n                                Farmacias registradas en CABA\n                            </h2>\n                            <p class=\"mt-1.5 text-sm leading-6 text-slate-600\" data-kid=\"1-4-2-3-2-1-1-2\" data-name=\"pharmacy list description\">\n                                El registro es independiente de la búsqueda; no informa precio ni stock. Llamá para consultar antes de ir.\n                            </p>\n                        </div>\n                        <div class=\"flex w-full flex-col gap-2 sm:w-72 sm:shrink-0\" data-kid=\"1-4-2-3-2-1-2\" data-name=\"pharmacy filter container\">\n                            <label class=\"text-sm font-semibold text-slate-600\" data-kid=\"1-4-2-3-2-1-2-1\" data-name=\"filter label\" for=\"pharmacy-filter\">\n                                Filtrar farmacias\n                            </label>\n                            <input class=\"h-11 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm text-slate-900 placeholder:text-slate-500\" data-kid=\"1-4-2-3-2-1-2-2\" data-name=\"filter input field\" id=\"pharmacy-filter\" placeholder=\"Barrio, comuna o nombre\" type=\"search\"/>\n                            <p class=\"text-sm text-slate-600\" data-dynamic=\"true\" data-kid=\"1-4-2-3-2-1-2-3\" data-name=\"filter result count\" data-reason=\"count text updated by filter script\">\n                                1.240 de 1.240\n                            </p>\n                        </div>\n                    </div>\n                    <ul class=\"mt-4\" data-kid=\"1-4-2-3-2-2\" data-name=\"pharmacy list\">\n                        <li class=\"grid gap-3 border-t border-slate-200 py-4 sm:grid-cols-[minmax(0,1.2fr)_minmax(10rem,0.8fr)_auto] sm:items-center\" data-kid=\"1-4-2-3-2-2-1\" data-name=\"pharmacy list item\">\n                            <div class=\"min-w-0\" data-kid=\"1-4-2-3-2-2-1-1\" data-name=\"pharmacy details\">\n                                <h3 class=\"text-sm font-semibold text-slate-900\" data-kid=\"1-4-2-3-2-2-1-1-1\" data-name=\"pharmacy name\">\n                                    Farmacia (Cordoba Av. 2060)\n                                </h3>\n                                <p class=\"mt-1 text-sm leading-5 text-slate-600\" data-kid=\"1-4-2-3-2-2-1-1-2\" data-name=\"pharmacy address info\">\n                                    Cordoba Av. 2060\n                                    <span class=\"text-slate-500\" data-kid=\"1-4-2-3-2-2-1-1-2-1\" data-name=\"pharmacy neighborhood and district\">\n                                        · Balvanera · Comuna 3\n                                    </span>\n                                </p>\n                            </div>\n                            <span class=\"text-sm text-slate-500\" data-kid=\"1-4-2-3-2-2-1-2\" data-name=\"pharmacy distance status\">\n                                Sin ubicación para calcular distancia\n                            </span>\n                            <a class=\"inline-flex min-h-11 items-center justify-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white\" data-kid=\"1-4-2-3-2-2-1-3\" data-name=\"directions button\" href=\"#\">\n                                Abrir ruta\n                            </a>\n                        </li>\n                        <li class=\"grid gap-3 border-t border-slate-200 py-4 sm:grid-cols-[minmax(0,1.2fr)_minmax(10rem,0.8fr)_auto] sm:items-center\" data-kid=\"1-4-2-3-2-2-2\" data-name=\"pharmacy list item\">\n                            <div class=\"min-w-0\" data-kid=\"1-4-2-3-2-2-2-1\" data-name=\"pharmacy details\">\n                                <h3 class=\"text-sm font-semibold text-slate-900\" data-kid=\"1-4-2-3-2-2-2-1-1\" data-name=\"pharmacy name\">\n                                    Farmacia (Cordoba Av. 3200)\n                                </h3>\n                                <p class=\"mt-1 text-sm leading-5 text-slate-600\" data-kid=\"1-4-2-3-2-2-2-1-2\" data-name=\"pharmacy address info\">\n                                    Cordoba Av. 3200\n                                    <span class=\"text-slate-500\" data-kid=\"1-4-2-3-2-2-2-1-2-1\" data-name=\"pharmacy neighborhood and district\">\n                                        · Balvanera · Comuna 3\n                                    </span>\n                                </p>\n                            </div>\n                            <span class=\"text-sm text-slate-500\" data-kid=\"1-4-2-3-2-2-2-2\" data-name=\"pharmacy distance status\">\n                                Sin ubicación para calcular distancia\n                            </span>\n                            <a class=\"inline-flex min-h-11 items-center justify-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white\" data-kid=\"1-4-2-3-2-2-2-3\" data-name=\"directions button\" href=\"#\">\n                                Abrir ruta\n                            </a>\n                        </li>\n                        <li class=\"grid gap-3 border-t border-slate-200 py-4 sm:grid-cols-[minmax(0,1.2fr)_minmax(10rem,0.8fr)_auto] sm:items-center\" data-kid=\"1-4-2-3-2-2-3\" data-name=\"pharmacy list item\">\n                            <div class=\"min-w-0\" data-kid=\"1-4-2-3-2-2-3-1\" data-name=\"pharmacy details\">\n                                <h3 class=\"text-sm font-semibold text-slate-900\" data-kid=\"1-4-2-3-2-2-3-1-1\" data-name=\"pharmacy name\">\n                                    Farmacia (Entre Rios Av. 1686)\n                                </h3>\n                                <p class=\"mt-1 text-sm leading-5 text-slate-600\" data-kid=\"1-4-2-3-2-2-3-1-2\" data-name=\"pharmacy address info\">\n                                    Entre Rios Av. 1686\n                                    <span class=\"text-slate-500\" data-kid=\"1-4-2-3-2-2-3-1-2-1\" data-name=\"pharmacy neighborhood and district\">\n                                        · Constitución · Comuna 1\n                                    </span>\n                                </p>\n                            </div>\n                            <span class=\"text-sm text-slate-500\" data-kid=\"1-4-2-3-2-2-3-2\" data-name=\"pharmacy distance status\">\n                                Sin ubicación para calcular distancia\n                            </span>\n                            <a class=\"inline-flex min-h-11 items-center justify-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white\" data-kid=\"1-4-2-3-2-2-3-3\" data-name=\"directions button\" href=\"#\">\n                                Abrir ruta\n                            </a>\n                        </li>\n                        <li class=\"grid gap-3 border-t border-slate-200 py-4 sm:grid-cols-[minmax(0,1.2fr)_minmax(10rem,0.8fr)_auto] sm:items-center\" data-kid=\"1-4-2-3-2-2-4\" data-name=\"pharmacy list item\">\n                            <div class=\"min-w-0\" data-kid=\"1-4-2-3-2-2-4-1\" data-name=\"pharmacy details\">\n                                <h3 class=\"text-sm font-semibold text-slate-900\" data-kid=\"1-4-2-3-2-2-4-1-1\" data-name=\"pharmacy name\">\n                                    Farmacia (Montes De Oca, Manuel Av. 1405)\n                                </h3>\n                                <p class=\"mt-1 text-sm leading-5 text-slate-600\" data-kid=\"1-4-2-3-2-2-4-1-2\" data-name=\"pharmacy address info\">\n                                    Montes De Oca, Manuel Av. 1405\n                                    <span class=\"text-slate-500\" data-kid=\"1-4-2-3-2-2-4-1-2-1\" data-name=\"pharmacy neighborhood and district\">\n                                        · Barracas · Comuna 4\n                                    </span>\n                                </p>\n                            </div>\n                            <span class=\"text-sm text-slate-500\" data-kid=\"1-4-2-3-2-2-4-2\" data-name=\"pharmacy distance status\">\n                                Sin ubicación para calcular distancia\n                            </span>\n                            <a class=\"inline-flex min-h-11 items-center justify-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white\" data-kid=\"1-4-2-3-2-2-4-3\" data-name=\"directions button\" href=\"#\">\n                                Abrir ruta\n                            </a>\n                        </li>\n                    </ul>\n                    <button class=\"mt-3 inline-flex min-h-11 items-center gap-2 rounded-lg px-1 text-sm font-semibold text-sky-800\" data-kid=\"1-4-2-3-2-3\" data-name=\"see all pharmacies button\">\n                        <i class=\"ti ti-chevron-down\" data-kid=\"1-4-2-3-2-3-1\" data-name=\"chevron icon\">\n                        </i>\n                        Ver las 1.240 farmacias\n                    </button>\n                    <p class=\"mt-1 text-sm text-slate-500\" data-kid=\"1-4-2-3-2-4\" data-name=\"pharmacy list note\">\n                        Sin ubicación activada, la lista está en orden alfabético.\n                    </p>\n                </section>\n            </section>\n            <section aria-labelledby=\"sources-title\" class=\"mt-10 border-t border-slate-200 pt-6\" data-kid=\"1-4-2-4\" data-name=\"sources and limitations section\">\n                <h2 class=\"text-base font-bold text-slate-800\" data-kid=\"1-4-2-4-1\" data-name=\"sources title\" id=\"sources-title\">\n                    Fuentes y limitaciones\n                </h2>\n                <div class=\"mt-3 grid gap-3 sm:grid-cols-2\" data-kid=\"1-4-2-4-2\" data-name=\"sources content container\">\n                    <p class=\"text-sm leading-6 text-slate-600\" data-kid=\"1-4-2-4-2-1\" data-name=\"price source text\">\n                        <strong class=\"font-semibold text-slate-800\" data-kid=\"1-4-2-4-2-1-1\" data-name=\"source emphasis\">\n                            Precios:\n                        </strong>\n                        referencia CNPM · catálogo parcial basado en una semilla PAMI.\n                    </p>\n                    <p class=\"text-sm leading-6 text-slate-600\" data-kid=\"1-4-2-4-2-2\" data-name=\"pharmacy source text\">\n                        <strong class=\"font-semibold text-slate-800\" data-kid=\"1-4-2-4-2-2-1\" data-name=\"source emphasis\">\n                            Farmacias:\n                        </strong>\n                        registro de CABA independiente; no informa precio ni stock.\n                    </p>\n                </div>\n                <p class=\"mt-4 rounded-xl bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-950\" data-kid=\"1-4-2-4-3\" data-name=\"disclaimer warning box\">\n                    Confirmá precio y disponibilidad directamente con la farmacia. La consulta de referencia no informa precios de sucursales. No es consejo médico.\n                </p>\n            </section>\n        </section>\n    </main>\n    <footer class=\"border-t border-slate-200 bg-white\" data-kid=\"1-5\" data-name=\"footer\">\n        <div class=\"mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-sm text-slate-500 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8\" data-kid=\"1-5-1\" data-name=\"footer content container\">\n            <p data-kid=\"1-5-1-1\" data-name=\"footer app name\">\n                FarmaciaCerca · Versión alpha\n            </p>\n            <p data-kid=\"1-5-1-2\" data-name=\"footer disclaimer text\">\n                No es consejo médico. Confirmá precio y disponibilidad con la farmacia.\n            </p>\n        </div>\n    </footer>\n    <aside aria-label=\"Nota de pruebas para desarrollo\" class=\"mx-auto mt-5 max-w-6xl px-4 pb-6 sm:px-6 lg:px-8\" data-kid=\"1-6\" data-name=\"development notes section\">\n        <div class=\"rounded-xl border border-violet-200 bg-violet-50 px-4 py-3.5\" data-kid=\"1-6-1\" data-name=\"qa container\">\n            <div class=\"flex items-start gap-3\" data-kid=\"1-6-1-1\" data-name=\"qa header container\">\n                <span class=\"flex size-8 shrink-0 items-center justify-center rounded-lg bg-violet-100 text-violet-800\" data-kid=\"1-6-1-1-1\" data-name=\"terminal icon box\">\n                    <i class=\"ti ti-terminal-2 text-base\" data-kid=\"1-6-1-1-1-1\" data-name=\"terminal icon\">\n                    </i>\n                </span>\n                <div data-kid=\"1-6-1-1-2\" data-name=\"qa text container\">\n                    <p class=\"text-xs font-extrabold tracking-[0.08em] text-violet-900\" data-kid=\"1-6-1-1-2-1\" data-name=\"qa title\">\n                        QA · npm run test:layout\n                    </p>\n                    <p class=\"mt-1 text-sm leading-5 text-violet-950\" data-kid=\"1-6-1-1-2-2\" data-name=\"qa description\">\n                        Regresión: principal → directorio → relacionadas. Sin coincidencias: se ocultan ambas listas de resultados y el directorio permanece visible.\n                    </p>\n                    <p class=\"mt-1 text-xs text-violet-800\" data-kid=\"1-6-1-1-2-3\" data-name=\"qa footer note\">\n                        Nota de desarrollo · fuera de la interfaz del producto\n                    </p>\n                </div>\n            </div>\n        </div>\n    </aside>\n</div>\n",
