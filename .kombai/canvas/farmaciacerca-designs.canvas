      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen w-full bg-slate-50 font-[Inter,ui-sans-serif,system-ui,sans-serif] text-slate-900\" data-kid=\"1\">\n    <div class=\"border-b border-emerald-100 bg-emerald-50 px-3 py-1.5 text-center text-[10px] font-bold uppercase tracking-wide text-emerald-900\" data-kid=\"1-1\" data-name=\"status banner text\">\n        IN USE · MOBILE CON RESULTADOS\n    </div>\n    <header class=\"border-b border-slate-200 bg-white\" data-kid=\"1-2\">\n        <div class=\"flex items-center justify-between gap-3 px-4 py-3\" data-kid=\"1-2-1\">\n            <a aria-label=\"FarmaciaCerca, inicio\" class=\"flex min-w-0 items-center gap-2.5\" data-kid=\"1-2-1-1\" data-name=\"brand link logo and name\" href=\"#\">\n                <span class=\"flex size-9 shrink-0 items-center justify-center rounded-xl bg-sky-600 text-white shadow-sm shadow-sky-900/15\" data-kid=\"1-2-1-1-1\" data-name=\"brand icon container\">\n                    <span class=\"text-2xl font-light leading-none\" data-kid=\"1-2-1-1-1-1\" data-name=\"brand symbol text\">\n                        +\n                    </span>\n                </span>\n                <span class=\"min-w-0\" data-kid=\"1-2-1-1-2\" data-name=\"brand name and subtitle container\">\n                    <span class=\"block text-sm font-extrabold tracking-tight text-slate-950\" data-kid=\"1-2-1-1-2-1\" data-name=\"brand name\">\n                        FarmaciaCerca\n                    </span>\n                    <span class=\"block truncate text-[10px] font-medium text-slate-600\" data-kid=\"1-2-1-1-2-2\" data-name=\"brand reference source text\">\n                        Precio de referencia · Ministerio de Salud\n                    </span>\n                </span>\n            </a>\n            <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-2-1-2\" data-name=\"header action buttons container\">\n                <button aria-label=\"Cambiar tema\" class=\"flex size-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600\" data-kid=\"1-2-1-2-1\" data-name=\"theme toggle button\">\n                    <i class=\"ti ti-moon text-lg\" data-kid=\"1-2-1-2-1-1\" data-name=\"moon icon\">\n                    </i>\n                </button>\n                <button class=\"inline-flex min-h-10 items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-2.5 text-xs font-bold text-slate-700\" data-kid=\"1-2-1-2-2\" data-name=\"location button\">\n                    <i class=\"ti ti-map-pin text-sm text-sky-700\" data-kid=\"1-2-1-2-2-1\" data-name=\"location pin icon\">\n                    </i>\n                    Ubicación\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"px-4 pb-8 pt-6\" data-kid=\"1-3\">\n        <section aria-labelledby=\"search-title\" data-kid=\"1-3-1\" data-name=\"search section\">\n            <h1 class=\"text-[27px] font-extrabold leading-[1.14] tracking-tight text-slate-950\" data-kid=\"1-3-1-1\" data-name=\"search section headline\" id=\"search-title\">\n                Buscá por principio activo o nombre comercial\n            </h1>\n            <p class=\"mt-2 text-sm leading-5 text-slate-600\" data-kid=\"1-3-1-2\" data-name=\"search section description\">\n                Compará precios de referencia entre laboratorios para una misma presentación.\n            </p>\n            <div class=\"mt-4 flex min-w-0 items-center gap-1.5 rounded-2xl border border-slate-200 bg-white p-1.5 shadow-sm shadow-slate-900/5\" data-kid=\"1-3-1-3\" data-name=\"search input container\">\n                <i class=\"ti ti-search ml-2 text-lg text-slate-400\" data-kid=\"1-3-1-3-1\" data-name=\"search icon\">\n                </i>\n                <label class=\"sr-only\" data-kid=\"1-3-1-3-2\" data-name=\"search label\" for=\"medicine-search\">\n                    Buscar por principio activo o nombre comercial\n                </label>\n                <input class=\"h-11 min-w-0 flex-1 bg-transparent px-1 text-sm text-slate-900 outline-none placeholder:text-slate-400\" data-kid=\"1-3-1-3-3\" data-name=\"search input field\" id=\"medicine-search\" type=\"search\" value=\"ibuprofeno\"/>\n                <button aria-label=\"Limpiar búsqueda\" class=\"inline-flex min-h-10 items-center rounded-lg px-2 text-sm font-semibold text-slate-600\" data-kid=\"1-3-1-3-4\" data-name=\"clear search button\">\n                    <i class=\"ti ti-x\" data-kid=\"1-3-1-3-4-1\" data-name=\"close icon\">\n                    </i>\n                </button>\n            </div>\n            <p class=\"mt-2 text-xs leading-5 text-slate-500\" data-kid=\"1-3-1-4\" data-name=\"price comparison note\">\n                El precio se compara entre laboratorios de una misma presentación.\n            </p>\n            <p class=\"mt-2 border-b border-slate-200 pb-4 text-xs text-slate-600\" data-kid=\"1-3-1-5\" data-name=\"catalog product count info\">\n                <strong class=\"font-semibold text-slate-800\" data-kid=\"1-3-1-5-1\" data-name=\"catalog source bold text\">\n                    Catálogo parcial\n                </strong>\n                · 1.923 productos\n            </p>\n        </section>\n        <section aria-labelledby=\"prices-title\" class=\"pt-5\" data-kid=\"1-3-2\" data-name=\"results section\">\n            <h2 class=\"text-xl font-bold tracking-tight text-slate-950\" data-kid=\"1-3-2-1\" data-name=\"results section headline\" id=\"prices-title\">\n                Precios de referencia\n            </h2>\n            <p class=\"mt-1 text-sm text-slate-600\" data-kid=\"1-3-2-2\" data-name=\"results composition count text\">\n                13 composiciones para “ibuprofeno”\n            </p>\n            <p class=\"mt-1 text-sm text-slate-600\" data-kid=\"1-3-2-3\" data-name=\"coincidence status text\">\n                <strong class=\"font-semibold text-slate-800\" data-kid=\"1-3-2-3-1\" data-name=\"main coincidence label\">\n                    1 coincidencia principal\n                </strong>\n                <span class=\"mx-1.5 text-slate-400\" data-kid=\"1-3-2-3-2\" data-name=\"separator dot\">\n                    ·\n                </span>\n                12 relacionadas\n            </p>\n            <div class=\"mt-3 flex flex-col gap-1.5\" data-kid=\"1-3-2-4\" data-name=\"sorting control container\">\n                <label class=\"text-sm font-semibold text-slate-600\" data-kid=\"1-3-2-4-1\" data-name=\"sorting label\" for=\"sort-results\">\n                    Ordenar resultados\n                </label>\n                <select class=\"h-11 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm font-medium text-slate-700\" data-kid=\"1-3-2-4-2\" data-name=\"sorting dropdown menu\" id=\"sort-results\">\n                    <option data-kid=\"1-3-2-4-2-1\" data-name=\"default sort option\">\n                        Menor precio mínimo de referencia\n                    </option>\n                </select>\n                <p class=\"text-xs leading-5 text-slate-500\" data-kid=\"1-3-2-4-3\" data-name=\"sorting explanation text\">\n                    Ordená por el menor precio de referencia de cada composición; puede corresponder a distintas presentaciones.\n                </p>\n            </div>\n            <section aria-labelledby=\"primary-results-title\" class=\"mt-5\" data-kid=\"1-3-2-5\" data-name=\"primary results section\">\n                <div class=\"mb-2 flex items-center justify-between gap-2\" data-kid=\"1-3-2-5-1\" data-name=\"primary results header container\">\n                    <h3 class=\"text-sm font-bold text-slate-800\" data-kid=\"1-3-2-5-1-1\" data-name=\"primary results title\" id=\"primary-results-title\">\n                        Coincidencias principales\n                    </h3>\n                    <span class=\"shrink-0 text-xs text-slate-500\" data-kid=\"1-3-2-5-1-2\" data-name=\"primary composition count\">\n                        1 composición\n                    </span>\n                </div>\n                <article class=\"rounded-2xl border border-slate-200 bg-white p-4 shadow-sm shadow-slate-900/5\" data-kid=\"1-3-2-5-2\" data-name=\"primary result article card\">\n                    <div data-kid=\"1-3-2-5-2-1\" data-name=\"article header content container\">\n                        <span class=\"text-xs font-semibold text-sky-800\" data-kid=\"1-3-2-5-2-1-1\" data-name=\"active ingredient label\">\n                            Principio activo\n                        </span>\n                        <h4 class=\"mt-1 text-xl font-bold tracking-tight text-slate-950\" data-kid=\"1-3-2-5-2-1-2\" data-name=\"active ingredient name\">\n                            ibuprofeno\n                        </h4>\n                        <p class=\"mt-1 text-xs leading-5 text-slate-600\" data-kid=\"1-3-2-5-2-1-3\" data-name=\"product count and examples\">\n                            159 productos en 78 presentaciones · incluye IBUPROFENO FECOFAR, IBUPROFENO ROSPAW 400\n                        </p>\n                    </div>\n                    <div class=\"mt-3 flex items-start justify-between gap-3 rounded-xl bg-slate-50 px-3 py-2.5\" data-kid=\"1-3-2-5-2-2\" data-name=\"price highlight container\">\n                        <div data-kid=\"1-3-2-5-2-2-1\" data-name=\"price highlight content\">\n                            <p class=\"text-xs font-medium text-slate-600\" data-kid=\"1-3-2-5-2-2-1-1\" data-name=\"price label text\">\n                                Desde · referencia\n                            </p>\n                            <p class=\"mt-0.5 text-2xl font-extrabold tracking-tight text-sky-800\" data-kid=\"1-3-2-5-2-2-1-2\" data-name=\"minimum price value\">\n                                $ 663\n                            </p>\n                        </div>\n                        <p class=\"max-w-32 pt-1 text-right text-xs leading-4 text-slate-500\" data-kid=\"1-3-2-5-2-2-2\" data-name=\"price disclaimer text\">\n                            Mínimo entre distintas presentaciones\n                        </p>\n                    </div>\n                    <ul class=\"mt-2 divide-y divide-slate-200\" data-kid=\"1-3-2-5-2-3\" data-name=\"presentations list\">\n                        <li class=\"py-3.5\" data-kid=\"1-3-2-5-2-3-1\" data-name=\"presentation item 1\">\n                            <div class=\"flex items-start justify-between gap-2\" data-kid=\"1-3-2-5-2-3-1-1\" data-name=\"presentation header\">\n                                <div class=\"min-w-0\" data-kid=\"1-3-2-5-2-3-1-1-1\" data-name=\"presentation details container\">\n                                    <p class=\"text-sm font-bold text-slate-900\" data-kid=\"1-3-2-5-2-3-1-1-1-1\" data-name=\"presentation name\">\n                                        susp.oral x 90 ml\n                                    </p>\n                                    <p class=\"mt-0.5 text-xs text-slate-600\" data-kid=\"1-3-2-5-2-3-1-1-1-2\" data-name=\"presentation type\">\n                                        jarabe · vía oral\n                                    </p>\n                                </div>\n                                <div class=\"shrink-0 text-right\" data-kid=\"1-3-2-5-2-3-1-1-2\" data-name=\"price range container\">\n                                    <p class=\"text-base font-extrabold text-slate-900\" data-kid=\"1-3-2-5-2-3-1-1-2-1\" data-name=\"price range value\">\n                                        $ 663 - $ 12.608\n                                    </p>\n                                    <p class=\"text-xs text-slate-600\" data-kid=\"1-3-2-5-2-3-1-1-2-2\" data-name=\"price difference note\">\n                                        hasta 19,0 x de diferencia\n                                    </p>\n                                </div>\n                            </div>\n                            <p class=\"mt-2 text-xs leading-5 text-slate-600\" data-kid=\"1-3-2-5-2-3-1-2\" data-name=\"best price highlight\">\n                                <strong class=\"font-semibold text-slate-800\" data-kid=\"1-3-2-5-2-3-1-2-1\" data-name=\"best price label\">\n                                    Más barato:\n                                </strong>\n                                IBUPROFENO FECOFAR · Fecofar · $ 663\n                            </p>\n                            <p class=\"mt-1 text-[11px] leading-4 text-slate-500\" data-kid=\"1-3-2-5-2-3-1-3\" data-name=\"presentation price caveat\">\n                                Rango de referencia para esta presentación; no es precio de farmacia.\n                            </p>\n                            <button class=\"mt-2 inline-flex min-h-10 items-center gap-1 rounded-lg px-1 text-xs font-semibold text-sky-800\" data-kid=\"1-3-2-5-2-3-1-4\" data-name=\"show more products button\">\n                                <i class=\"ti ti-chevron-down\" data-kid=\"1-3-2-5-2-3-1-4-1\" data-name=\"chevron icon\">\n                                </i>\n                                Ver 5 productos\n                            </button>\n                        </li>\n                        <li class=\"border-t border-slate-200 py-3.5\" data-kid=\"1-3-2-5-2-3-2\" data-name=\"presentation item 2\">\n                            <div class=\"flex items-start justify-between gap-2\" data-kid=\"1-3-2-5-2-3-2-1\" data-name=\"presentation item 2 header\">\n                                <div data-kid=\"1-3-2-5-2-3-2-1-1\" data-name=\"presentation item 2 name details\">\n                                    <p class=\"text-sm font-bold text-slate-900\" data-kid=\"1-3-2-5-2-3-2-1-1-1\" data-name=\"presentation item 2 name\">\n                                        400 mg comp.x 10\n                                    </p>\n                                    <p class=\"mt-0.5 text-xs text-slate-600\" data-kid=\"1-3-2-5-2-3-2-1-1-2\" data-name=\"presentation item 2 type\">\n                                        comprimido · vía oral\n                                    </p>\n                                </div>\n                                <div class=\"shrink-0 text-right\" data-kid=\"1-3-2-5-2-3-2-1-2\" data-name=\"price range container\">\n                                    <p class=\"text-base font-bold text-slate-900\" data-kid=\"1-3-2-5-2-3-2-1-2-1\" data-name=\"price range item 2 value\">\n                                        $ 1.250 - $ 4.700\n                                    </p>\n                                    <p class=\"text-xs text-slate-600\" data-kid=\"1-3-2-5-2-3-2-1-2-2\" data-name=\"presentation item 2 note\">\n                                        esta presentación\n                                    </p>\n                                </div>\n                            </div>\n                        </li>\n                    </ul>\n                    <button class=\"mt-1 inline-flex min-h-10 items-center rounded-lg px-1 text-xs font-semibold text-sky-800\" data-kid=\"1-3-2-5-2-4\" data-name=\"view all presentations button\">\n                        Ver las 78 presentaciones\n                    </button>\n                </article>\n            </section>\n        </section>\n        <section aria-labelledby=\"pharmacies-title\" class=\"mt-5 border-t border-slate-200 pt-4\" data-kid=\"1-3-3\" data-name=\"pharmacy list section\">\n            <h2 class=\"text-lg font-bold tracking-tight text-slate-950\" data-kid=\"1-3-3-1\" data-name=\"pharmacy list title\" id=\"pharmacies-title\">\n                Farmacias registradas en CABA\n            </h2>\n            <p class=\"mt-1 text-xs leading-5 text-slate-600\" data-kid=\"1-3-3-2\" data-name=\"pharmacy disclaimer\">\n                El registro es independiente de la búsqueda; no informa precio ni stock. Llamá para consultar antes de ir.\n            </p>\n            <label class=\"mt-3 block text-xs font-semibold text-slate-600\" data-kid=\"1-3-3-3\" data-name=\"pharmacy filter label\" for=\"pharmacy-filter\">\n                Filtrar farmacias\n            </label>\n            <input class=\"mt-1 h-10 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm text-slate-900 placeholder:text-slate-500\" data-kid=\"1-3-3-4\" data-name=\"pharmacy filter input field\" id=\"pharmacy-filter\" placeholder=\"Barrio, comuna o nombre\" type=\"search\"/>\n            <p class=\"mt-1.5 text-xs text-slate-600\" data-kid=\"1-3-3-5\" data-name=\"pharmacy count display\">\n                1.240 de 1.240\n            </p>\n            <ul class=\"mt-2\" data-kid=\"1-3-3-6\" data-name=\"pharmacies list\">\n                <li class=\"grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2 border-t border-slate-200 py-3\" data-kid=\"1-3-3-6-1\" data-name=\"pharmacy item 1\">\n                    <div class=\"min-w-0\" data-kid=\"1-3-3-6-1-1\" data-name=\"pharmacy info container\">\n                        <h3 class=\"break-words text-xs font-semibold text-slate-900\" data-kid=\"1-3-3-6-1-1-1\" data-name=\"pharmacy name\">\n                            Farmacia (Cordoba Av. 2060)\n                        </h3>\n                        <p class=\"mt-0.5 text-xs leading-4 text-slate-600\" data-kid=\"1-3-3-6-1-1-2\" data-name=\"pharmacy address details\">\n                            Cordoba Av. 2060 · Balvanera · Comuna 3\n                        </p>\n                    </div>\n                    <a class=\"inline-flex min-h-9 shrink-0 items-center justify-center rounded-lg bg-slate-900 px-2.5 text-xs font-semibold text-white\" data-kid=\"1-3-3-6-1-2\" data-name=\"open route button\" href=\"#\">\n                        Abrir ruta\n                    </a>\n                </li>\n                <li class=\"grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2 border-t border-slate-200 py-3\" data-kid=\"1-3-3-6-2\" data-name=\"pharmacy item 2\">\n                    <div class=\"min-w-0\" data-kid=\"1-3-3-6-2-1\" data-name=\"pharmacy item 2 info container\">\n                        <h3 class=\"break-words text-xs font-semibold text-slate-900\" data-kid=\"1-3-3-6-2-1-1\" data-name=\"pharmacy item 2 name\">\n                            Farmacia (Cordoba Av. 3200)\n                        </h3>\n                        <p class=\"mt-0.5 text-xs leading-4 text-slate-600\" data-kid=\"1-3-3-6-2-1-2\" data-name=\"pharmacy item 2 address details\">\n                            Cordoba Av. 3200 · Balvanera · Comuna 3\n                        </p>\n                    </div>\n                    <a class=\"inline-flex min-h-9 shrink-0 items-center justify-center rounded-lg bg-slate-900 px-2.5 text-xs font-semibold text-white\" data-kid=\"1-3-3-6-2-2\" data-name=\"open route item 2 button\" href=\"#\">\n                        Abrir ruta\n                    </a>\n                </li>\n            </ul>\n            <p class=\"mt-2 rounded-lg bg-slate-100 px-3 py-2 text-xs text-slate-600\" data-kid=\"1-3-3-7\" data-name=\"geolocation status notice\">\n                <i class=\"ti ti-map-pin mr-1 text-slate-500\" data-kid=\"1-3-3-7-1\" data-name=\"location pin icon small\">\n                </i>\n                Sin ubicación activada; la lista está en orden alfabético.\n            </p>\n            <button class=\"mt-2 inline-flex min-h-10 items-center gap-1 rounded-lg px-1 text-xs font-semibold text-sky-800\" data-kid=\"1-3-3-8\" data-name=\"view all pharmacies button\">\n                <i class=\"ti ti-chevron-down\" data-kid=\"1-3-3-8-1\" data-name=\"chevron icon small\">\n                </i>\n                Ver las 1.240 farmacias\n            </button>\n        </section>\n        <section aria-labelledby=\"related-title\" class=\"mt-5 border-t border-slate-200 pt-4\" data-kid=\"1-3-4\" data-name=\"related results section\">\n            <div class=\"flex items-start justify-between gap-2\" data-kid=\"1-3-4-1\" data-name=\"related results header\">\n                <h2 class=\"text-base font-bold text-slate-800\" data-kid=\"1-3-4-1-1\" data-name=\"related results title\" id=\"related-title\">\n                    Coincidencias relacionadas\n                </h2>\n                <span class=\"shrink-0 rounded-md bg-amber-50 px-2 py-1 text-xs font-semibold text-amber-800\" data-kid=\"1-3-4-1-2\" data-name=\"related results count badge\">\n                    12 resultados\n                </span>\n            </div>\n            <p class=\"mt-1 text-xs leading-5 text-slate-600\" data-kid=\"1-3-4-2\" data-name=\"related results disclaimer\">\n                Asociaciones y nombres afines; no son el mismo medicamento.\n            </p>\n            <ul class=\"mt-2 space-y-2\" data-kid=\"1-3-4-3\" data-name=\"related list\">\n                <li data-kid=\"1-3-4-3-1\" data-name=\"related item 1\">\n                    <article class=\"rounded-xl border border-slate-200 bg-white p-3\" data-kid=\"1-3-4-3-1-1\" data-name=\"related item 1 card\">\n                        <span class=\"text-[10px] font-semibold text-amber-800\" data-kid=\"1-3-4-3-1-1-1\" data-name=\"related item 1 category label\">\n                            Asociación\n                        </span>\n                        <h3 class=\"mt-0.5 text-sm font-bold text-slate-950\" data-kid=\"1-3-4-3-1-1-2\" data-name=\"related item 1 title\">\n                            ibuprofeno + codeína\n                        </h3>\n                    </article>\n                </li>\n                <li data-kid=\"1-3-4-3-2\" data-name=\"related item 2\">\n                    <article class=\"rounded-xl border border-slate-200 bg-white p-3\" data-kid=\"1-3-4-3-2-1\" data-name=\"related item 2 card\">\n                        <span class=\"text-[10px] font-semibold text-amber-800\" data-kid=\"1-3-4-3-2-1-1\" data-name=\"related item 2 category label\">\n                            Asociación\n                        </span>\n                        <h3 class=\"mt-0.5 text-sm font-bold text-slate-950\" data-kid=\"1-3-4-3-2-1-2\" data-name=\"related item 2 title\">\n                            ibuprofeno + cafeína\n                        </h3>\n                    </article>\n                </li>\n            </ul>\n        </section>\n        <section aria-labelledby=\"sources-title\" class=\"mt-6 border-t border-slate-200 pt-4\" data-kid=\"1-3-5\" data-name=\"sources section\">\n            <h2 class=\"text-sm font-bold text-slate-800\" data-kid=\"1-3-5-1\" data-name=\"sources section title\" id=\"sources-title\">\n                Fuentes y limitaciones\n            </h2>\n            <p class=\"mt-2 text-xs leading-5 text-slate-600\" data-kid=\"1-3-5-2\" data-name=\"sources information\">\n                Precios de referencia CNPM · catálogo parcial basado en una semilla PAMI. Cobertura de farmacias: CABA.\n            </p>\n            <p class=\"mt-3 rounded-lg bg-amber-50 px-3 py-2.5 text-xs leading-5 text-amber-950\" data-kid=\"1-3-5-3\" data-name=\"safety warning notice\">\n                Compará únicamente presentaciones iguales. Confirmá precio y disponibilidad con la farmacia. No es consejo médico.\n            </p>\n        </section>\n    </main>\n    <footer class=\"border-t border-slate-200 bg-white px-4 py-4 text-xs text-slate-500\" data-kid=\"1-4\" data-name=\"footer section\">\n        <p data-kid=\"1-4-1\" data-name=\"product branding and version\">\n            FarmaciaCerca · Versión alpha\n        </p>\n        <p class=\"mt-1\" data-kid=\"1-4-2\" data-name=\"footer safety warning\">\n            No es consejo médico. Confirmá precio y disponibilidad con la farmacia.\n        </p>\n    </footer>\n    <aside aria-label=\"Nota de pruebas para desarrollo\" class=\"border-t border-violet-200 bg-violet-50 px-4 py-3\" data-kid=\"1-5\" data-name=\"qa testing note aside\">\n        <p class=\"text-[10px] font-extrabold tracking-wide text-violet-900\" data-kid=\"1-5-1\" data-name=\"qa tool command text\">\n            QA · npm run test:layout\n        </p>\n        <p class=\"mt-1 text-[11px] leading-4 text-violet-950\" data-kid=\"1-5-2\" data-name=\"qa layout navigation path\">\n            principal → directorio → relacionadas\n        </p>\n        <p class=\"text-[10px] text-violet-800\" data-kid=\"1-5-3\" data-name=\"qa scope notice\">\n            Nota de desarrollo · fuera de la interfaz del producto\n        </p>\n    </aside>\n</div>\n",
